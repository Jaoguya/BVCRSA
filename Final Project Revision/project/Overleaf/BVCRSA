\subsubsection*{\textbf{Phase 1 --- System Setup}}

The Trusted Authority (TA) initializes the system parameters and
distributes the required credentials. Let $\lambda$ be the security
parameter, $\mathcal{U}$ the attribute universe, and
$\mathcal{D}=\{D_1,\ldots,D_d\}$ the searchable numerical dimensions.

\paragraph*{Step 1: ABSE Initialization}

BVCRSA employs an Attribute-Based Searchable Encryption scheme
defined by
\begin{equation}
\mathsf{ABSE}
=
(\mathsf{Setup},\mathsf{KeyGen},\mathsf{Index},
\mathsf{Token},\mathsf{Test},\mathsf{Enc},\mathsf{Dec}),
\label{eq:abse-interface}
\end{equation}
where $\mathsf{Index}$, $\mathsf{Token}$, and $\mathsf{Test}$ provide
policy-controlled keyword search, while $\mathsf{Enc}$ and
$\mathsf{Dec}$ provide policy-controlled encapsulation of node and
record keys. These functions may be instantiated by a single ABSE
scheme or by a secure composition of searchable ABSE and an
attribute-based KEM.

The TA initializes the scheme as
\begin{equation}
(PP,MSK)
\leftarrow
\mathsf{ABSE.Setup}(1^\lambda),
\qquad
PP=(p,\mathbb G_1,\mathbb G_T,e,g),
\label{eq:abse-setup}
\end{equation}
where $(p,\mathbb G_1,\mathbb G_T,e,g)$ are the BN254 pairing
parameters. For each user with attribute set
$\mathcal A\subseteq\mathcal U$, the TA issues
\begin{equation}
SK_{\mathcal A}
\leftarrow
\mathsf{ABSE.KeyGen}(MSK,\mathcal A).
\label{eq:abse-keygen}
\end{equation}

For keyword $w$, policy $\mathcal P$, context epoch $e_c$, query
identifier $qid$, and encapsulated message $M$, define
\begin{equation}
\begin{aligned}
I_w
&=
\mathsf{ABSE.Index}(PP,w,\mathcal P,e_c),\\
Tok_{w'}
&=
\mathsf{ABSE.Token}
(PP,SK_{\mathcal A},w',e_c,qid),\\
C_M
&=
\mathsf{ABSE.Enc}(PP,M,\mathcal P,e_c).
\end{aligned}
\label{eq:abse-components}
\end{equation}
Search correctness requires
\begin{equation}
\mathsf{ABSE.Test}
(PP,I_w,Tok_{w'},e_c,qid)=1
\quad\Longleftrightarrow\quad
\bigl(w=w'\land\mathcal A\models\mathcal P\bigr),
\label{eq:abse-search-correctness}
\end{equation}
whereas encapsulation correctness requires
\begin{equation}
\mathsf{ABSE.Dec}
(SK_{\mathcal A},C_M,e_c)=M
\quad\Longleftrightarrow\quad
\mathcal A\models\mathcal P.
\label{eq:abse-decryption-correctness}
\end{equation}
Here, $e_c=e_q$ for query-node keys and $e_c=e_i$ for
record-specific keys.

\paragraph*{Step 2: Threshold Homomorphic Encryption Initialization}

The TA initializes lifted threshold EC-ElGamal over NIST P-256. Let
$G$ generate a group of order $q_E$. It samples
\begin{equation}
x\xleftarrow{\$}\mathbb{Z}_{q_E}^{*},
\qquad
pk_{\mathrm{AHE}}=xG,
\label{eq:ahe-keygen}
\end{equation}
and constructs the degree-$(t-1)$ Shamir polynomial
\begin{equation}
f(z)
=
x+\sum_{j=1}^{t-1}a_jz^j,
\qquad
a_j\xleftarrow{\$}\mathbb{Z}_{q_E}.
\label{eq:shamir-polynomial}
\end{equation}
The secret and public shares of TDA $\ell$ are
\begin{equation}
sk_\ell=f(\ell),
\qquad
pk_\ell=sk_\ell G,
\qquad
\ell\in\{1,\ldots,n\}.
\label{eq:tda-shares}
\end{equation}
A bounded value $v$ is encrypted as
\begin{equation}
\mathsf{Enc}^{\mathrm{AHE}}_{pk_{\mathrm{AHE}}}(v)
=
(rG,vG+rpk_{\mathrm{AHE}}),
\qquad
r\xleftarrow{\$}\mathbb{Z}_{q_E}^{*},
\label{eq:ahe-encryption}
\end{equation}
thereby supporting additive homomorphic aggregation.

\paragraph*{Step 3: Primitive Initialization}

The TA instantiates HMAC-SHA-256 as the pseudorandom function $F$,
a BN254-compatible hash-to-group function $H_g$, SHA-256 as $H$,
HKDF-SHA-256 as $\mathsf{KDF}$, and HKDF-Expand as
$\mathsf{PRG}$. It also instantiates ECDSA over secp256k1 as
\begin{equation}
\mathsf{DS}
=
(\mathsf{KeyGen},\mathsf{Sign},\mathsf{Verify})
\label{eq:signature-scheme}
\end{equation}
and a Chaum--Pedersen DLEQ proof system for verifying threshold
partial decryptions.

\paragraph*{Step 4: Credential Distribution}

For each sensor $i$, the TA derives
\begin{equation}
\begin{aligned}
K_{\mathrm{AES}}^{(i)}
&=
\mathsf{KDF}
(K_{\mathrm{master}},ID_i\parallel\mathtt{enc}),\\
K_{\mathrm{HMAC}}^{(i)}
&=
\mathsf{KDF}
(K_{\mathrm{master}},ID_i\parallel\mathtt{hmac}).
\end{aligned}
\label{eq:sensor-keys}
\end{equation}
It independently generates the gateway secrets:
\begin{equation}
K_{\mathrm{sel}}
\xleftarrow{\$}
\{0,1\}^{\lambda},
\qquad
(pk_{\mathrm{DO}},sk_{\mathrm{DO}})
\leftarrow
\mathsf{DS.KeyGen}(1^\lambda).
\label{eq:gateway-keys}
\end{equation}
Through authenticated secure channels, the TA distributes
\begin{equation}
\begin{aligned}
\text{Sensor }i &:\
(K_{\mathrm{AES}}^{(i)},K_{\mathrm{HMAC}}^{(i)},pk_{\mathrm{AHE}}),\\
\text{Authorized user} &:\
SK_{\mathcal A},\\
\text{Edge Gateway} &:\
(K_{\mathrm{sel}},sk_{\mathrm{DO}}),\\
\text{TDA }\ell &:\
sk_\ell.
\end{aligned}
\label{eq:credential-distribution}
\end{equation}
In particular, $K_{\mathrm{sel}}$ is never distributed to users;
they obtain only policy-authorized node keys through ABSE.

\paragraph*{Step 5: Public-State Initialization}

The TA publishes
\begin{equation}
\mathsf{Pub}
=
\left(
PP,pk_{\mathrm{AHE}},pk_{\mathrm{DO}},
\{pk_\ell\}_{\ell=1}^{n}
\right)
\label{eq:public-parameters}
\end{equation}
and anchors the initial commitment $Root_0$ on the permissioned
blockchain. The nonpublic state is partitioned as
\begin{equation}
\begin{aligned}
\mathsf{Sec}_{\mathrm{TA}}
&=(MSK,K_{\mathrm{master}}),\\
\mathsf{Sec}_{\mathrm{GW}}
&=(K_{\mathrm{sel}},sk_{\mathrm{DO}}),\\
\mathsf{Sec}_{\mathrm{TDA}}
&=\{sk_\ell\}_{\ell=1}^{n}.
\end{aligned}
\label{eq:secret-state}
\end{equation}
After setup, the TA does not participate in indexing, query
processing, aggregation, or result verification.

\subsubsection*{\textbf{Phase 2 --- Sensor-Side Encryption and Authenticated Index Construction}}

This phase converts sensor readings into authenticated structures
supporting policy-controlled conjunctive range search, encrypted
aggregation, and blockchain-verifiable integrity.

\paragraph*{Step 1: Sensor Encryption and Authentication}

For each sensor record
\begin{equation}
D_i
=
(m_i,\mathbf{x}_i,t_i,v_i),
\qquad
\mathbf{x}_i=(x_{i,1},\ldots,x_{i,d}),
\label{eq:p2-record}
\end{equation}
the sensor derives
\begin{equation}
rid_i
=
H(ID_i\parallel seq_i),
\qquad
Meta_i
=
\{(D_j,u_{i,j})\}_{j=1}^{d},
\label{eq:p2-metadata}
\end{equation}
where $u_{i,j}$ is the canonical leaf containing $x_{i,j}$. Let
$e_i$ denote the finalized ingestion epoch of record $i$. The
authenticated record header is
\begin{equation}
Hdr_i
=
(ID_i,rid_i,seq_i,N_i,e_i).
\label{eq:p2-record-header}
\end{equation}

To avoid exposing its long-term key, the sensor derives a
record-specific key and encapsulates it under policy $\mathcal P_i$:
\begin{equation}
\begin{aligned}
K_i^{\mathrm{rec}}
&=
\mathsf{KDF}
(K_{\mathrm{AES}}^{(i)},rid_i\parallel N_i),\\
C_i^{\mathrm{rec}}
&=
\mathsf{ABSE.Enc}
(PP,K_i^{\mathrm{rec}},\mathcal P_i,e_i).
\end{aligned}
\label{eq:p2-record-key}
\end{equation}
It then encrypts the complete record and aggregation value as
\begin{equation}
\begin{aligned}
CT_{\mathrm{AES}}^{(i)}
&=
\mathsf{AES\mbox{-}GCM.Enc}_{K_i^{\mathrm{rec}}}
\bigl(
N_i,D_i;\mathsf{enc}(Hdr_i)
\bigr),\\
CT_v^{(i)}
&=
(r_iG,v_iG+r_i pk_{\mathrm{AHE}}),
\qquad
r_i\xleftarrow{\$}\mathbb Z_{q_E}^{*}.
\end{aligned}
\label{eq:p2-record-encryption}
\end{equation}
The sensor transmits
\begin{equation}
\begin{aligned}
\mathcal P_i
={}&
(Hdr_i,CT_{\mathrm{AES}}^{(i)},C_i^{\mathrm{rec}},
CT_v^{(i)},Meta_i,Tag_i),\\
Tag_i
={}&
\mathsf{HMAC}_{K_{\mathrm{HMAC}}^{(i)}}
\left(
\mathsf{enc}(\mathcal P_i\setminus\{Tag_i\})
\right).
\end{aligned}
\label{eq:p2-sensor-packet}
\end{equation}

\paragraph*{Step 2: Edge Verification and Bitmap Update}

The Edge Gateway accepts $\mathcal P_i$ only if
\begin{equation}
\begin{split}
&\mathsf{HMAC.Verify}_{K_{\mathrm{HMAC}}^{(i)}}
\left(\mathsf{enc}(\mathcal P_i\setminus\{Tag_i\}),Tag_i\right)=1 \\
&\quad\land\; seq_i>seq_i^{\mathrm{last}} \\
&\quad\land\; \mathsf{Valid}(Meta_i)=1.
\end{split}
\label{eq:p2-packet-verification}
\end{equation}
It atomically registers $rid_i$, assigns a unique global bitmap
position $pos_i$, updates $seq_i^{\mathrm{last}}\leftarrow seq_i$,
and sets
\begin{equation}
B_u[pos_i]\leftarrow1,
\qquad
u\in\mathsf{Path}(u_{i,j}),
\quad
(D_j,u_{i,j})\in Meta_i.
\label{eq:p2-bitmap-update}
\end{equation}
A repeated $rid_i$ is rejected, preventing duplicate index and
aggregation entries.

\paragraph*{Step 3: Policy-Bound Index and Bitmap Construction}

For each node $u$ representing interval $[l_u,r_u]$, the gateway
derives
\begin{equation}
\tau_u
=
H_g(D_j\parallel l_u\parallel r_u),
\qquad
K_u
=
F(K_{\mathrm{sel}},D_j\parallel u),
\label{eq:p2-node-key}
\end{equation}
and constructs
\begin{equation}
\begin{split}
I_u &= \mathsf{ABSE.Index}(PP,\tau_u,\mathcal P_u,e_q), \\
C_u^K &= \mathsf{ABSE.Enc}(PP,K_u,\mathcal P_u,e_q).
\end{split}
\label{eq:p2-policy-index}
\end{equation}
Thus, only a user satisfying $\mathcal P_u$ can match $I_u$ and
recover $K_u$.

Let $N_{e_q}$ be the number of indexed records at epoch $e_q$ and
$\beta$ the fixed bitmap-block length. Every aligned bitmap contains
\begin{equation}
n_{e_q}^{\mathrm{blk}}
=
\left\lceil
\frac{N_{e_q}}{\beta}
\right\rceil
\label{eq:p2-bitmap-block-count}
\end{equation}
blocks, including authenticated all-zero blocks where necessary.
Whenever an existing block changes, its version is incremented;
new blocks are initialized with $\nu_{u,b}=0$. Each block is
protected and committed as
\begin{equation}
\begin{aligned}
\nu_{u,b}
&\leftarrow\nu_{u,b}+1
\quad\text{for an updated block},\\
\widetilde B_{u,b}
&=
B_{u,b}\oplus
\mathsf{PRG}
\left(
F(K_u,b\parallel\nu_{u,b}),|B_{u,b}|
\right),\\
\sigma_{u,b}^{\mathrm{bmp}}
&=
H\bigl(
\mathtt{BMP}\parallel D_j\parallel u\parallel b
\parallel\nu_{u,b}\parallel\widetilde B_{u,b}
\bigr).
\end{aligned}
\label{eq:p2-protected-block}
\end{equation}
Because the block commitment is version-bound rather than
epoch-bound, unchanged blocks need not be re-masked or rehashed at
every epoch.

The gateway computes
\begin{equation}
\begin{aligned}
Root_u^{\mathrm{bmp}}
&=
\mathsf{MerkleRoot}
\left(
\mathsf{Sort}_{b}
\{\sigma_{u,b}^{\mathrm{bmp}}\}_{b=1}^{n_{e_q}^{\mathrm{blk}}}
\right),\\[4pt]
\sigma_u^{\mathrm{idx}}
&=
H\bigl(
\mathtt{IDX}\parallel e_q\parallel D_j\parallel u
\parallel I_u\parallel C_u^K
\parallel N_{e_q}\parallel\beta\\
&\qquad\quad
\parallel n_{e_q}^{\mathrm{blk}}
\parallel Root_u^{\mathrm{bmp}}
\bigr).
\end{aligned}
\label{eq:p2-index-leaf}
\end{equation}
Binding $N_{e_q}$, $\beta$, and $n_{e_q}^{\mathrm{blk}}$ enables
detection of omitted, duplicated, reordered, or truncated bitmap
blocks.

\paragraph*{Step 4: Aggregation Registration}

For each accepted record, the gateway creates
\begin{equation}
\begin{aligned}
CT_1^{(i)}
&=
\mathsf{Enc}^{\mathrm{AHE}}_{pk_{\mathrm{AHE}}}(1),\\
h_i^{\mathrm{rec}}
&=
H\bigl(
\mathsf{enc}(Hdr_i)\parallel
CT_{\mathrm{AES}}^{(i)}
\parallel C_i^{\mathrm{rec}}
\bigr),\\
\mathcal A_i
&=
(pos_i,rid_i,e_i,h_i^{\mathrm{rec}},
CT_v^{(i)},CT_1^{(i)}),\\
\sigma_i^{\mathrm{agg}}
&=
H\bigl(
\mathtt{AGG}\parallel e_i
\parallel\mathsf{enc}(\mathcal A_i)
\bigr).
\end{aligned}
\label{eq:p2-aggregation-entry}
\end{equation}
The immutable ingestion epoch $e_i$ allows historical aggregation
entries to remain unchanged across later epochs, while the unique
pair $(pos_i,rid_i)$ prevents duplicate contributions.

\paragraph*{Step 5: Epoch Commitment and Outsourcing}

At the end of epoch $e_q$, the gateway computes
\begin{equation}
\begin{aligned}
Root_{e_q}^{\mathrm{idx}}
&=
\mathsf{MerkleRoot}
\left(
\mathsf{Sort}_{(D_j,u)}
\{\sigma_u^{\mathrm{idx}}\}
\right),\\
Root_{e_q}^{\mathrm{agg}}
&=
\mathsf{MerkleRoot}
\left(
\mathsf{Sort}_{pos_i}
\{\sigma_i^{\mathrm{agg}}\}
\right),\\
Root_{e_q}
&=
H\bigl(
\mathtt{EPOCH}\parallel e_q
\parallel N_{e_q}\parallel\beta
\parallel n_{e_q}^{\mathrm{blk}}
\parallel Root_{e_q}^{\mathrm{idx}}
\parallel Root_{e_q}^{\mathrm{agg}}
\bigr),\\
\sigma_{\mathrm{DO}}
&=
\mathsf{DS.Sign}_{sk_{\mathrm{DO}}}
\left(
H(Root_{e_q}\parallel e_q\parallel ts_{e_q})
\right).
\end{aligned}
\label{eq:p2-epoch-commitment}
\end{equation}
It anchors
\begin{equation}
(e_q,N_{e_q},\beta,n_{e_q}^{\mathrm{blk}},
Root_{e_q},ts_{e_q},\sigma_{\mathrm{DO}})
\label{eq:p2-blockchain-anchor}
\end{equation}
on the permissioned blockchain and outsources
\begin{equation}
\begin{split}
\mathcal O_{e_q}
= \bigl\{
Hdr_i,\, CT_{\mathrm{AES}}^{(i)},\, C_i^{\mathrm{rec}},\,
I_u,\, C_u^K,\, \widetilde B_{u,b},\, \nu_{u,b},\\
\mathcal A_i,\, \sigma_{u,b}^{\mathrm{bmp}},\,
\sigma_u^{\mathrm{idx}},\, \sigma_i^{\mathrm{agg}}
\bigr\}
\end{split}
\label{eq:p2-outsourcing}
\end{equation}
to the cloud. The gateway retains $K_{\mathrm{sel}}$, while users
recover only the node and record keys authorized by their ABSE
policies.

\subsubsection*{\textbf{Phase 3 --- Conjunctive Range-Query Trapdoor Generation}}

An authorized user with attribute key $SK_{\mathcal A}$ generates an
epoch-bound ABSE trapdoor for a conjunctive range query. The numerical
bounds are protected by ABSE, subject to the declared leakage of the
query structure, matched nodes, and access pattern.

\paragraph*{Step 1: Canonical Range Decomposition}

A $d$-dimensional conjunctive range query is
\begin{equation}
Q
=
\bigwedge_{j=1}^{d}
\bigl(D_j,[a_j,b_j]\bigr).
\label{eq:p3-query}
\end{equation}
For each dimension $D_j$, the user computes the minimal canonical
cover
\begin{equation}
\begin{aligned}
\mathcal{C}_j
&= \mathsf{Cover}(D_j,[a_j,b_j])
= \{u_{j,1},\ldots,u_{j,\ell_j}\}, \\
\ell_j &= O(\log|D_j|).
\end{aligned}
\label{eq:p3-canonical-cover}
\end{equation}
Nodes within $\mathcal{C}_j$ are evaluated disjunctively, whereas
the dimension-level results are evaluated conjunctively.

\paragraph*{Step 2: Epoch-Bound Token Generation}

The user retrieves a finalized epoch $e_q$ and its authenticated root
$Root_{e_q}$ from the blockchain, selects an expiration time
$t_{\mathrm{exp}}$, and derives a fresh query identifier:
\begin{equation}
n_q\xleftarrow{\$}\{0,1\}^{\lambda},
\qquad
qid
=
H(e_q\parallel Root_{e_q}\parallel
t_{\mathrm{exp}}\parallel n_q).
\label{eq:p3-query-id}
\end{equation}
For every $u_{j,i}\in\mathcal{C}_j$ representing interval
$[l_{u_{j,i}},r_{u_{j,i}}]$, the user reconstructs the node keyword
\begin{equation}
\tau_{j,i}
=
H_g\bigl(
D_j\parallel l_{u_{j,i}}\parallel r_{u_{j,i}}
\bigr)
\label{eq:p3-node-keyword}
\end{equation}
and invokes the native randomized ABSE token algorithm:
\begin{equation}
Tok_{j,i}
\leftarrow
\mathsf{ABSE.Token}
\bigl(
PP,SK_{\mathcal A},\tau_{j,i},e_q,qid
\bigr).
\label{eq:p3-search-token}
\end{equation}
The binding to $(e_q,qid)$ prevents cross-query or cross-epoch token
substitution, while $t_{\mathrm{exp}}$ limits replay through its
binding to $qid$.

\paragraph*{Step 3: Trapdoor Construction}

For each dimension $D_j$, the user forms
\begin{equation}
\Gamma_j
=
\{Tok_{j,i}\}_{i=1}^{\ell_j}.
\label{eq:p3-token-group}
\end{equation}
The complete trapdoor is
\begin{equation}
T_Q
=
\left(
e_q,N_{e_q},\beta,n_{e_q}^{\mathrm{blk}},
Root_{e_q},qid,t_{\mathrm{exp}},
\{\Gamma_j\}_{j=1}^{d}
\right),
\label{eq:p3-trapdoor}
\end{equation}
where the public bitmap parameters are authenticated through
$Root_{e_q}$. The trapdoor size remains
\begin{equation}
|T_Q|
=
O\left(
\sum_{j=1}^{d}\ell_j
\right)
=
O\left(
\sum_{j=1}^{d}\log|D_j|
\right),
\label{eq:p3-trapdoor-size}
\end{equation}
because $(e_q,N_{e_q},\beta,n_{e_q}^{\mathrm{blk}},
Root_{e_q},qid,t_{\mathrm{exp}})$ has constant size.

For every token $Tok_{j,i}$, the cloud evaluates
\begin{equation}
b_{u,j,i}
=
\mathsf{ABSE.Test}
(PP,I_u,Tok_{j,i},e_q,qid)
\label{eq:p3-token-evaluation}
\end{equation}
over the candidate searchable indexes and retains each node for which
$b_{u,j,i}=1$. Without an additional privacy-preserving lookup
mechanism, a token may need to be tested against all $N_u$ node
indexes, yielding
\begin{equation}
T_{\mathrm{match}}
=
O\left(
N_u
\sum_{j=1}^{d}\ell_j
\right)
=
O(N_um_c),
\label{eq:p3-matching-complexity}
\end{equation}
where $m_c=\sum_{j=1}^{d}\ell_j$. If the selected ABSE provides an
indexed hidden-lookup procedure, this exhaustive test may be replaced
by that procedure, and its leakage and complexity must be stated
accordingly.

The cloud subsequently returns the matching node-key envelopes,
exactly $n_{e_q}^{\mathrm{blk}}$ protected blocks per matched node,
and their Merkle proofs in Phase~4. Node-key recovery and bitmap
reconstruction are performed only by the authorized user. Thus,
$T_Q$ exposes neither $K_{\mathrm{sel}}$ nor any node key.


\subsubsection*{\textbf{Phase 4 --- Verifiable Conjunctive Range Search and Aggregation}}

Using $T_Q$, the cloud identifies the authorized canonical nodes and
returns their protected bitmap blocks. The user verifies and
reconstructs the bitmaps, computes the conjunctive result, and
requests homomorphic aggregation over the matched positions.

\paragraph*{Step 1: Authorized Node Matching}

For each $Tok_{j,i}\in\Gamma_j$, the cloud evaluates
\begin{equation}
b_{u,j,i}
=
\mathsf{ABSE.Test}
(PP,I_u,Tok_{j,i},e_q,qid).
\label{eq:p4-token-test}
\end{equation}
If $b_{u,j,i}=1$, it adds $u$ to $\mathcal M_j$ and binds the
response to the corresponding token through
\begin{equation}
\chi_{j,i}
=
H(e_q\parallel qid\parallel\mathsf{enc}(Tok_{j,i})).
\label{eq:p4-token-reference}
\end{equation}
The complete matched-node set is
\begin{equation}
\mathcal U_Q
=
\bigcup_{j=1}^{d}\mathcal M_j.
\label{eq:p4-matched-nodes}
\end{equation}

The cloud returns
\begin{equation}
\begin{aligned}
\mathcal{Rsp}_Q^{(1)}
=
\Bigl(
&e_q,qid,N_{e_q},\beta,n_{e_q}^{\mathrm{blk}},\\
&\bigl\{
\chi_{j,i},D_j,u,I_u,C_u^K,
Root_u^{\mathrm{bmp}},\pi_u^{\mathrm{idx}},\\
&\hspace{1.5em}
\{\widetilde B_{u,b},\nu_{u,b},
\sigma_{u,b}^{\mathrm{bmp}},
\pi_{u,b}^{\mathrm{bmp}}\}_{b=1}^{n_{e_q}^{\mathrm{blk}}}
\bigr\}_{u\in\mathcal U_Q}
\Bigr).
\end{aligned}
\label{eq:p4-first-response}
\end{equation}
Here, $\pi_u^{\mathrm{idx}}$ authenticates the index leaf against
$Root_{e_q}^{\mathrm{idx}}$, while
$\pi_{u,b}^{\mathrm{bmp}}$ authenticates block $b$ against
$Root_u^{\mathrm{bmp}}$.


\paragraph*{Step 2: Bitmap Verification and Conjunctive Evaluation}

The user retrieves the finalized state and verifies
\begin{equation}
\begin{aligned}
Root_{e_q}
&=
H\bigl(
\mathtt{EPOCH}\parallel e_q
\parallel N_{e_q}\parallel\beta
\parallel n_{e_q}^{\mathrm{blk}}\\
&\qquad\quad
\parallel Root_{e_q}^{\mathrm{idx}}
\parallel Root_{e_q}^{\mathrm{agg}}
\bigr),\\[4pt]
\mathsf{DS.Verify}_{pk_{\mathrm{DO}}}
&\bigl(
H(Root_{e_q}\parallel e_q\parallel ts_{e_q}),
\sigma_{\mathrm{DO}}
\bigr)
=1.
\end{aligned}
\label{eq:p4-epoch-verification}
\end{equation}
It confirms that
$(e_q,N_{e_q},\beta,n_{e_q}^{\mathrm{blk}},Root_{e_q},qid)$
matches the unexpired trapdoor $T_Q$.

For each token $Tok_{j,i}$, the user requires exactly one returned
node satisfying
\begin{equation}
\begin{aligned}
\chi_{j,i}
&=
H(e_q\parallel qid\parallel\mathsf{enc}(Tok_{j,i})),\\[4pt]
\mathsf{ABSE.Test}
(PP,I_u,Tok_{j,i},\\
&\qquad e_q,qid)
=1,\\[4pt]
\mathsf{MerkleVerify}
(\sigma_u^{\mathrm{idx}},\pi_u^{\mathrm{idx}},\\
&\qquad Root_{e_q}^{\mathrm{idx}})
=1.
\end{aligned}
\label{eq:p4-match-verification}
\end{equation}
For every matched node, it also verifies the committed index leaf,
all bitmap-block proofs against $Root_u^{\mathrm{bmp}}$, and
\begin{equation}
\{b:\widetilde B_{u,b}\text{ is returned}\}
=
\{1,\ldots,n_{e_q}^{\mathrm{blk}}\}.
\label{eq:p4-block-completeness}
\end{equation}
Missing, duplicated, out-of-range, or invalid blocks cause rejection.

The user then recovers
\begin{equation}
\begin{aligned}
K_u
&=
\mathsf{ABSE.Dec}
(SK_{\mathcal A},C_u^K,e_q),\\
B_{u,b}
&=
\widetilde B_{u,b}
\oplus
\mathsf{PRG}
\left(
F(K_u,b\parallel\nu_{u,b}),|B_{u,b}|
\right).
\end{aligned}
\label{eq:p4-bitmap-recovery}
\end{equation}
After concatenating the blocks and truncating each bitmap to
$N_{e_q}$ bits, it computes
\begin{equation}
\begin{aligned}
B_{D_j} &= \bigvee_{u\in\mathcal M_j}B_u, \\
B_Q &= \bigwedge_{j=1}^{d}B_{D_j}, \\
\mathcal S_Q &= \{pos_i:B_Q[pos_i]=1\}.
\end{aligned}
\label{eq:p4-conjunctive-result}
\end{equation}
Finally, it submits
\begin{equation}
\mathcal{Req}_Q^{\mathrm{agg}}
=
(e_q,qid,H(B_Q),\mathcal S_Q)
\label{eq:p4-aggregation-request}
\end{equation}
through the authenticated query session.

\paragraph*{Step 3: Encrypted Aggregation}

For every $pos_i\in\mathcal{S}_Q$, the cloud retrieves the unique
aggregation entry $\mathcal{A}_i$ and computes
\begin{equation}
CT_{\mathrm{sum}}
=
\bigoplus_{E,\,pos_i\in\mathcal{S}_Q}CT_v^{(i)},
\qquad
CT_{\mathrm{count}}
=
\bigoplus_{E,\,pos_i\in\mathcal{S}_Q}CT_1^{(i)},
\label{eq:p4-encrypted-aggregation}
\end{equation}
where $\oplus_E$ denotes EC-ElGamal ciphertext addition. Since
$\mathcal{S}_Q$ contains unique positions, each selected record
contributes at most once.

The cloud generates
\begin{equation}
\pi_Q^{\mathrm{agg}}
=
\mathsf{MerkleMultiProof}
\left(
\{\sigma_i^{\mathrm{agg}}\}_{pos_i\in\mathcal{S}_Q},
Root_{e_q}^{\mathrm{agg}}
\right).
\label{eq:p4-aggregation-proof}
\end{equation}

\paragraph*{Step 4: Verifiable Response Construction}

Using aggregation entries ordered by $pos_i$, the cloud computes
\begin{equation}
\begin{aligned}
\Delta_Q
=
H\bigl(
&\mathtt{RESP}\parallel e_q\parallel qid
\parallel Root_{e_q}\parallel H(B_Q)\\
&\parallel H(\mathsf{enc}(\{\mathcal{A}_i\}))
\parallel CT_{\mathrm{sum}}
\parallel CT_{\mathrm{count}}
\bigr)
\end{aligned}
\label{eq:p4-response-digest}
\end{equation}
and returns
\begin{equation}
\begin{split}
\mathcal{Rsp}_Q^{(2)}
= \bigl(
e_q,\, qid,\, H(B_Q),\,
CT_{\mathrm{sum}},\, CT_{\mathrm{count}},\\
\{\mathcal{A}_i\}_{pos_i\in\mathcal{S}_Q},\,
\pi_Q^{\mathrm{agg}},\, \Delta_Q
\bigr).
\end{split}
\label{eq:p4-final-response}
\end{equation}
Phase~5 verifies the aggregation multi-proof, returned positions,
homomorphic recomputation, and response digest before threshold
decryption.

For record retrieval, the cloud additionally returns
\begin{equation}
\left\{
Hdr_i,CT_{\mathrm{AES}}^{(i)},C_i^{\mathrm{rec}}
\right\}_{pos_i\in\mathcal{S}_Q}.
\label{eq:p4-record-retrieval}
\end{equation}
These values are verified through $h_i^{\mathrm{rec}}$ before
record-key recovery and AES-GCM decryption. 

\subsubsection*{\textbf{Phase 5 --- Blockchain-Anchored Verification and Threshold Decryption}}

Upon receiving $\mathcal{Rsp}_Q^{(2)}$, the user verifies its
blockchain consistency and aggregation correctness before requesting
threshold or optional record decryption.

\paragraph*{Step 1: Blockchain and Response Verification}

The user retrieves
\begin{equation}
\begin{aligned}
State_{e_q}
=
\bigl(
&e_q,N_{e_q},\beta,n_{e_q}^{\mathrm{blk}},
Root_{e_q}^{\mathrm{idx}},Root_{e_q}^{\mathrm{agg}},\\
&Root_{e_q},ts_{e_q},\sigma_{\mathrm{DO}}
\bigr)
\end{aligned}
\label{eq:p5-state}
\end{equation}
and verifies
\begin{equation}
\begin{aligned}
Root_{e_q}
&=
H\bigl(
\mathtt{EPOCH}\parallel e_q
\parallel N_{e_q}\parallel\beta
\parallel n_{e_q}^{\mathrm{blk}}\\
&\qquad\quad
\parallel Root_{e_q}^{\mathrm{idx}}
\parallel Root_{e_q}^{\mathrm{agg}}
\bigr),\\[4pt]
\mathsf{DS.Verify}_{pk_{\mathrm{DO}}}
&\bigl(
H(Root_{e_q}\parallel e_q\parallel ts_{e_q}),
\sigma_{\mathrm{DO}}
\bigr)
=1.
\end{aligned}
\label{eq:p5-state-verification}
\end{equation}
It confirms that $(e_q,qid)$ is valid, unexpired, and bound to $T_Q$,
and that
\begin{equation}
\{pos_i:\mathcal A_i\in\mathcal{Rsp}_Q^{(2)}\}
=
\mathcal S_Q
=
\{pos_i:B_Q[pos_i]=1\}.
\label{eq:p5-position-verification}
\end{equation}

For each
$\mathcal A_i=(pos_i,rid_i,e_i,h_i^{\mathrm{rec}},
CT_v^{(i)},CT_1^{(i)})$, the user reconstructs
\begin{equation}
\sigma_i^{\mathrm{agg}}
=
H\bigl(
\mathtt{AGG}\parallel e_i
\parallel\mathsf{enc}(\mathcal A_i)
\bigr)
\label{eq:p5-aggregation-leaf}
\end{equation}
and verifies
\begin{equation}
\mathsf{MerkleMultiVerify}
\left(
\{\sigma_i^{\mathrm{agg}}\}_{pos_i\in\mathcal S_Q},
\pi_Q^{\mathrm{agg}},
Root_{e_q}^{\mathrm{agg}}
\right)=1.
\label{eq:p5-multiproof-verification}
\end{equation}

Using entries ordered by $pos_i$, the user recomputes
\begin{equation}
\widehat{CT}_{\mathrm{sum}}
=
\bigoplus_{E,\,pos_i\in\mathcal S_Q}CT_v^{(i)},
\qquad
\widehat{CT}_{\mathrm{count}}
=
\bigoplus_{E,\,pos_i\in\mathcal S_Q}CT_1^{(i)}
\label{eq:p5-aggregate-recomputation}
\end{equation}
and
\begin{equation}
\begin{aligned}
\widehat{\Delta}_Q
=
H\bigl(
&\mathtt{RESP}\parallel e_q\parallel qid
\parallel Root_{e_q}\parallel H(B_Q)\\
&\parallel H(\mathsf{enc}(\{\mathcal A_i\}))
\parallel CT_{\mathrm{sum}}
\parallel CT_{\mathrm{count}}
\bigr).
\end{aligned}
\label{eq:p5-response-digest}
\end{equation}
The response is accepted only if
\begin{equation}
\widehat{CT}_{\mathrm{sum}}=CT_{\mathrm{sum}}
\land
\widehat{CT}_{\mathrm{count}}=CT_{\mathrm{count}}
\land
\widehat{\Delta}_Q=\Delta_Q.
\label{eq:p5-response-acceptance}
\end{equation}

\paragraph*{Step 2: Verifiable Threshold Decryption}

The user submits
$(e_q,qid,\Delta_Q,CT_{\mathrm{sum}},CT_{\mathrm{count}})$
to the TDAs through an authenticated request bound to the accepted
response. For $CT_z=(C_1^z,C_2^z)$,
$z\in\{\mathrm{sum},\mathrm{count}\}$, each TDA
$\ell\in S$, where $|S|\geq t$, returns
\begin{equation}
\delta_\ell^z
=
sk_\ell C_1^z,
\qquad
\pi_\ell^z
=
\mathsf{DLEQ.Prove}
(sk_\ell;G,pk_\ell,C_1^z,\delta_\ell^z).
\label{eq:p5-partial-decryption}
\end{equation}
The user accepts a share only if
\begin{equation}
\mathsf{DLEQ.Verify}
(G,pk_\ell,C_1^z,\delta_\ell^z,\pi_\ell^z)=1
\label{eq:p5-dleq-verification}
\end{equation}
and combines at least $t$ valid shares:
\begin{equation}
D_z
=
\sum_{\ell\in S}\lambda_\ell\delta_\ell^z,
\qquad
\lambda_\ell
=
\prod_{\substack{k\in S\\k\neq\ell}}
\frac{k}{k-\ell}
\bmod q_E.
\label{eq:p5-share-combination}
\end{equation}
The aggregate plaintexts are recovered as
\begin{equation}
\begin{aligned}
M_z&=C_2^z-D_z,\\
Sum&=\mathsf{BSGS}(M_{\mathrm{sum}},\mathcal V_{\mathrm{sum}}),\\
Count&=\mathsf{BSGS}(M_{\mathrm{count}},[0,N_{e_q}]),
\end{aligned}
\qquad
Count=|\mathcal S_Q|.
\label{eq:p5-aggregate-recovery}
\end{equation}
For $Count>0$,
\begin{equation}
Avg=\frac{Sum}{Count}.
\label{eq:p5-average}
\end{equation}
If $Count=0$, the result is empty and $Avg$ is undefined.

\paragraph*{Step 3: Optional Record Decryption}

For $Hdr_i=(ID_i,rid_i,seq_i,N_i,e_i)$, the user verifies
\begin{equation}
H\bigl(
\mathsf{enc}(Hdr_i)\parallel
CT_{\mathrm{AES}}^{(i)}
\parallel C_i^{\mathrm{rec}}
\bigr)
=
h_i^{\mathrm{rec}}
\label{eq:p5-record-verification}
\end{equation}
and, if authorized, computes
\begin{equation}
\begin{aligned}
K_i^{\mathrm{rec}}
&=
\mathsf{ABSE.Dec}
(SK_{\mathcal A},C_i^{\mathrm{rec}},e_i),\\
D_i
&=
\mathsf{AES\mbox{-}GCM.Dec}_{K_i^{\mathrm{rec}}}
\bigl(
N_i,CT_{\mathrm{AES}}^{(i)};
\mathsf{enc}(Hdr_i)
\bigr).
\end{aligned}
\label{eq:p5-record-decryption}
\end{equation}
The result is accepted only if all required blockchain, Merkle,
aggregation, DLEQ, bounded-recovery, and AES-GCM checks succeed.

\section{Security Analysis}

\subsection{Security Model}

We consider a probabilistic polynomial-time (PPT) adversary
$\mathcal A$ that controls the cloud and communication channels. The
cloud may inspect its permitted leakage and arbitrarily omit, modify,
substitute, fabricate, or replay protocol messages. The Edge Gateway
is honest-but-curious and non-colluding: it follows the protocol but
observes sensor identities, canonical-node metadata, bitmap
memberships, and update patterns. Completeness is therefore defined
relative to the state committed by the gateway.

Unauthorized users may collude with the cloud and other users, while
fewer than $t$ TDAs may be corrupted. The adversary does not obtain
$MSK$, $K_{\mathrm{sel}}$, $sk_{\mathrm{DO}}$, an attribute key
satisfying an unauthorized policy, or at least $t$ valid threshold
shares. The blockchain is assumed to provide immutable finalized
states, cryptographic nonces are never reused, and protocol messages
are exchanged through authenticated channels.

The ABSE component is assumed to provide adaptive keyword privacy,
policy enforcement, user collusion resistance, randomized
context-bound tokens, and secure payload-key encapsulation through
\begin{equation}
\mathsf{ABSE}
=
(\mathsf{Setup},\mathsf{KeyGen},\mathsf{Index},
\mathsf{Token},\mathsf{Test},\mathsf{Enc},\mathsf{Dec}).
\label{eq:sec-abse-assumption}
\end{equation}
These properties may be instantiated by a single ABSE construction
or by a secure composition of searchable ABSE and an
attribute-based KEM.

The security objectives of BVCRSA are
\begin{equation}
\begin{split}
&\mathsf{PacketAuthenticity}
\wedge\mathsf{QueryPrivacy}
\wedge\mathsf{DataConfidentiality}\\
&\wedge\mathsf{PolicyEnforcement}
\wedge\mathsf{ThresholdSecurity}\\
&\wedge\mathsf{AggregationCorrectness}
\wedge\mathsf{StateIntegrity}
\wedge\mathsf{Freshness}.
\end{split}
\label{eq:security-objectives}
\end{equation}
BVCRSA does not protect against denial of service, a malicious
gateway that commits incorrect data, collusion between the gateway
and cloud, compromise of at least $t$ TDAs, or leakage explicitly
permitted below.

\subsection{Leakage Profile}

BVCRSA permits only the structural leakage required for encrypted
indexing, search, and aggregation. The cloud-side leakage is
\begin{equation}
\mathcal L_{\mathrm{BVCRSA}}
=
\left(
\mathcal L_{\mathrm{Setup}},
\mathcal L_{\mathrm{Data}},
\mathcal L_{\mathrm{Query}},
\mathcal L_{\mathrm{Access}}
\right).
\label{eq:leakage-profile}
\end{equation}

The public parameters and finalized epoch states reveal
\begin{equation}
\mathcal L_{\mathrm{Setup}}
=
\left(
\mathsf{Pub},
\{e_q,N_{e_q},\beta,n_{e_q}^{\mathrm{blk}},
Root_{e_q},ts_{e_q},\sigma_{\mathrm{DO}}\}
\right).
\label{eq:setup-leakage}
\end{equation}

During outsourcing, the cloud observes the public record headers,
index topology, ciphertext lengths, protected-bitmap structure,
aggregation-entry structure, policy shapes, and update pattern:
\begin{equation}
\begin{aligned}
\mathcal L_{\mathrm{Data}}
=
\bigl(
&N_{e_q},N_u,\beta,n_{e_q}^{\mathrm{blk}},
\{Hdr_i,pos_i,h_i^{\mathrm{rec}}\},\\
&\{D_j,u\},
\{|CT_{\mathrm{AES}}^{(i)}|,
  |C_i^{\mathrm{rec}}|,|CT_v^{(i)}|,|CT_1^{(i)}|\},\\
&\{|I_u|,|C_u^K|\},
\{|\widetilde B_{u,b}|,\nu_{u,b}\},\\
&\{|\mathcal P_u|,|\mathcal P_i|\},
\mathsf{UpdPat}
\bigr),
\end{aligned}
\label{eq:data-leakage}
\end{equation}
where
\begin{equation}
Hdr_i=(ID_i,rid_i,seq_i,N_i,e_i).
\label{eq:leaked-record-header}
\end{equation}
If the selected ABSE does not hide access policies, the corresponding
policies or access structures, rather than only their sizes, are
included in $\mathcal L_{\mathrm{Data}}$.

For each query, the cloud observes
\begin{equation}
\mathcal L_{\mathrm{Query}}
=
\left(
d,\{\ell_j\}_{j=1}^{d},|T_Q|,
\mathsf{SP}_Q,\mathcal U_Q
\right),
\label{eq:query-leakage}
\end{equation}
where $\mathsf{SP}_Q$ denotes repeated tokens and matched-node
patterns. Since canonical nodes correspond to public intervals,
$\mathcal U_Q$ may reveal partial or complete query-range semantics.

The second query round additionally reveals
\begin{equation}
\mathcal L_{\mathrm{Access}}
=
\left(
\mathcal S_Q,|\mathcal S_Q|,
H(B_Q),\mathsf{AP}_Q,
\mathsf{Ret}_Q,\text{response sizes}
\right),
\label{eq:access-leakage}
\end{equation}
where $\mathsf{AP}_Q$ denotes repeated result-position patterns and
$\mathsf{Ret}_Q\subseteq\mathcal S_Q$ denotes the positions for which
encrypted records are requested. The cloud does not directly learn
the reconstructed node bitmaps $\{B_u\}$ or conjunctive bitmap $B_Q$,
although $\mathcal S_Q$ reveals the final matching positions.

The honest-but-curious gateway additionally observes
\begin{equation}
\begin{aligned}
\mathcal L_{\mathrm{GW}}
&=
\left(
\{Hdr_i,Meta_i,pos_i\},
N_{e_q},\beta,n_{e_q}^{\mathrm{blk}}
\right)\\
&\quad
\left(
\mathsf{UpdPat},\text{bitmap memberships}
\right).
\end{aligned}
\label{eq:gateway-leakage}
\end{equation}
Therefore, confidentiality against the gateway protects complete
sensor records, record-specific keys, and aggregate plaintexts, but
not the canonical-node metadata and bitmap memberships required for
index construction.

\subsection{Theorem 1: Sensor-Packet Authenticity}

\textbf{Theorem 1.}
Assuming the EUF-CMA security of HMAC and monotonically increasing
sequence numbers, a PPT adversary cannot forge, modify, or replay an
accepted sensor packet except with negligible probability.

\textbf{Proof.}
Sensor $i$ authenticates
\begin{equation}
Tag_i
=
\mathsf{HMAC}_{K_{\mathrm{HMAC}}^{(i)}}
\left(
\mathsf{enc}(\mathcal P_i\setminus\{Tag_i\})
\right).
\label{eq:sec-sensor-tag}
\end{equation}
The gateway accepts $\mathcal P_i$ only if
\begin{equation}
\begin{aligned}
&\mathsf{HMAC.Verify}_{K_{\mathrm{HMAC}}^{(i)}}
\left(
\mathsf{enc}(\mathcal P_i\setminus\{Tag_i\}),Tag_i
\right)=1\\
&\qquad\land\; seq_i>seq_i^{\mathrm{last}} .
\end{aligned}
\label{eq:sec-packet-acceptance}
\end{equation}
Any modification to $rid_i$, $N_i$, $CT_{\mathrm{AES}}^{(i)}$,
$C_i^{\mathrm{rec}}$, $CT_v^{(i)}$, or $Meta_i$ requires a new valid
tag and therefore constitutes an HMAC forgery. Replaying a previously
accepted packet fails the sequence-number check. Hence,
\begin{equation}
\Pr[\mathsf{PacketForge}]
\leq
\mathsf{Adv}_{\mathcal A}^{\mathrm{HMAC\mbox{-}EUF\mbox{-}CMA}}
(\lambda)
+
\operatorname{negl}(\lambda).
\label{eq:packet-authenticity-bound}
\end{equation}
\hfill$\square$

\subsection{Theorem 2: Conjunctive Query Privacy}

\textbf{Theorem 2.}
Assuming adaptive keyword privacy of ABSE, BVCRSA reveals no
information about a conjunctive range query beyond
$\mathcal L_{\mathrm{Query}}$ and
$\mathcal L_{\mathrm{Access}}$.

\textbf{Proof.}
Consider the following games.

\textbf{Game $G_0$.}
The adversary observes the real searchable indexes, randomized
tokens, protected bitmap blocks, Merkle proofs, and access patterns.

\textbf{Game $G_1$.}
Replace each ABSE index and query token with a simulated value
generated from
$\mathcal L_{\mathrm{Query}}$. An adversary distinguishing $G_1$
from $G_0$ can be used to break the adaptive keyword privacy of ABSE:
\begin{equation}
\left|
\Pr[G_1]-\Pr[G_0]
\right|
\leq
\mathsf{Adv}_{\mathcal A}^{\mathrm{ABSE}}(\lambda).
\label{eq:query-game-bound}
\end{equation}
The remaining view in $G_1$ is determined by the disclosed token-group
sizes, matched nodes, selected positions, and response sizes.
Therefore,
\begin{equation}
\mathsf{Adv}_{\mathcal A}^{\mathrm{QPriv}}
\leq
\mathsf{Adv}_{\mathcal A}^{\mathrm{ABSE}}
+
\operatorname{negl}(\lambda).
\label{eq:query-privacy-bound}
\end{equation}

Randomized ABSE tokens hide their cryptographic encodings, but
queries remain linkable through $\mathsf{SP}_Q$ and
$\mathsf{AP}_Q$. Moreover, because matched canonical nodes are
included in the leakage, the theorem does not claim to hide query
semantics inferable from $\mathcal U_Q$.
\hfill$\square$

\subsection{Theorem 3: Outsourced-Data Confidentiality}

\textbf{Theorem 3.}
Assuming the pseudorandomness of $\mathsf{KDF}$, the security of ABSE
key encapsulation, the AEAD security of AES-GCM, the pseudorandomness
of the bitmap PRF/PRG, and the IND-CPA security of Threshold
EC-ElGamal, the cloud learns no sensor record, bitmap content, or
aggregation value beyond $\mathcal L_{\mathrm{BVCRSA}}$.

\textbf{Proof.}
We use a sequence of games.

\textbf{Game $G_0$.}
This is the real protocol execution.

\textbf{Game $G_1$.}
Replace each derived record key
\begin{equation}
K_i^{\mathrm{rec}}
=
\mathsf{KDF}
(K_{\mathrm{AES}}^{(i)},rid_i\parallel N_i)
\label{eq:sec-record-key}
\end{equation}
with an independent uniform key. Distinguishing $G_1$ from $G_0$
breaks the pseudorandomness of $\mathsf{KDF}$.

\textbf{Game $G_2$.}
Replace the ABSE envelopes $C_i^{\mathrm{rec}}$ and $C_u^K$ with
simulated ciphertexts for policies not satisfied by the adversary.
Distinguishing this game breaks the payload confidentiality of ABSE.

\textbf{Game $G_3$.}
Replace each AES-GCM ciphertext with an encryption of an equal-length
zero string. Since $N_i$ is unique and the associated data are
authenticated, distinguishing $G_3$ from $G_2$ breaks the AEAD
security of AES-GCM.

\textbf{Game $G_4$.}
Replace every protected bitmap mask
\begin{equation}
\mathsf{PRG}
\left(
F(K_u,b\parallel\nu_{u,b}),|B_{u,b}|
\right)
\label{eq:sec-bitmap-mask}
\end{equation}
with a uniform string of equal length. Distinguishing this replacement
breaks the pseudorandomness of $F$ or $\mathsf{PRG}$.

\textbf{Game $G_5$.}
Replace each Threshold EC-ElGamal ciphertext
\begin{equation}
CT_v^{(i)}
=
(r_iG,v_iG+r_i pk_{\mathrm{AHE}})
\label{eq:sec-value-ciphertext}
\end{equation}
with an encryption of a fixed value. Distinguishing this game breaks
the IND-CPA security of Threshold EC-ElGamal when fewer than $t$
shares are corrupted.

The view in $G_5$ depends only on the declared leakage. Hence,
\begin{equation}
\begin{aligned}
\mathsf{Adv}_{\mathcal A}^{\mathrm{Conf}}
\leq{}&
\mathsf{Adv}^{\mathrm{KDF}}
+\mathsf{Adv}^{\mathrm{ABSE\mbox{-}Enc}}
+\mathsf{Adv}^{\mathrm{AEAD}}\\
&+
\mathsf{Adv}^{\mathrm{PRF/PRG}}
+\mathsf{Adv}^{\mathrm{T\mbox{-}ECElGamal}}
+\operatorname{negl}(\lambda).
\end{aligned}
\label{eq:data-confidentiality-bound}
\end{equation}
This result applies to the cloud under the non-collusion assumption.
The gateway separately learns the metadata specified by
$\mathcal L_{\mathrm{GW}}$.
\hfill$\square$

\subsection{Theorem 4: Policy Enforcement and Anti-Collusion}

\textbf{Theorem 4.}
Assuming the policy security and collusion resistance of ABSE,
colluding users cannot recover a node or record key for a policy that
none of them satisfies individually.

\textbf{Proof.}
For node $u$, successful token matching and key recovery require
\begin{equation}
\begin{aligned}
&\mathsf{ABSE.Test}
(PP,I_u,Tok_{j,i},e_q,qid)=1,\\
&K_u=\mathsf{ABSE.Dec}(SK_{\mathcal A},C_u^K,e_q).
\end{aligned}
\label{eq:sec-node-authorization}
\end{equation}
which holds only if the token keyword matches $\tau_u$ and
$\mathcal A\models\mathcal P_u$.

For record $i$, the key envelope is bound to its immutable ingestion
epoch $e_i$:
\begin{equation}
C_i^{\mathrm{rec}}
=
\mathsf{ABSE.Enc}
(PP,K_i^{\mathrm{rec}},\mathcal P_i,e_i).
\label{eq:sec-record-envelope}
\end{equation}
Consequently, record-key recovery requires
\begin{equation}
K_i^{\mathrm{rec}}
=
\mathsf{ABSE.Dec}
(SK_{\mathcal A},C_i^{\mathrm{rec}},e_i),
\qquad
\mathcal A\models\mathcal P_i.
\label{eq:sec-record-authorization}
\end{equation}
Using $e_q\neq e_i$ or an attribute key not satisfying
$\mathcal P_i$ causes decryption to fail.

Suppose users holding independently issued keys
$SK_{\mathcal A_1},\ldots,SK_{\mathcal A_c}$ collude. By ABSE
collusion resistance, key components are bound to their originating
users and cannot be combined into a new key satisfying a policy that
none of them satisfies individually. Therefore,
\begin{equation}
\mathsf{Adv}_{\mathcal A}^{\mathrm{Coll}}
\leq
\mathsf{Adv}_{\mathcal A}^{\mathrm{ABSE\mbox{-}Coll}}
+\operatorname{negl}(\lambda).
\label{eq:collusion-security-bound}
\end{equation}
Thus, BVCRSA enforces node- and record-level access policies against
colluding users under the assumed ABSE security.
\hfill$\square$
\subsection{Theorem 5: Threshold-Decryption Security}

\textbf{Theorem 5.}
No coalition containing fewer than $t$ TDAs can reconstruct the
aggregation secret key or decrypt an aggregate ciphertext.
Furthermore, an invalid partial decryption is detected except with
negligible probability.

\textbf{Proof.}
Let $CT_z=(C_1^z,C_2^z)$, where
$z\in\{\mathrm{sum},\mathrm{count}\}$. TDA $\ell$ computes
\begin{equation}
\delta_\ell^z
=
sk_\ell C_1^z
\label{eq:sec-partial-decryption}
\end{equation}
and proves
\begin{equation}
\log_G(pk_\ell)
=
\log_{C_1^z}(\delta_\ell^z)
\label{eq:sec-dleq-relation}
\end{equation}
using a Chaum--Pedersen DLEQ proof.

By the secrecy of Shamir sharing, any set of fewer than $t$ shares is
independent of the master key $x$. Consequently, such a coalition
cannot reconstruct
\begin{equation}
D_z
=
\sum_{\ell\in S}\lambda_\ell\delta_\ell^z
=
xC_1^z,
\qquad
|S|\geq t,
\label{eq:sec-share-reconstruction}
\end{equation}
or recover $M_z=C_2^z-D_z$. DLEQ soundness prevents a malicious TDA
from submitting an invalid share that passes verification. Thus,
\begin{equation}
\mathsf{Adv}_{\mathcal A}^{\mathrm{TDec}}
\leq
\mathsf{Adv}^{\mathrm{T\mbox{-}ECElGamal}}
+
\mathsf{Adv}^{\mathrm{DLEQ}}
+
\operatorname{negl}(\lambda).
\label{eq:threshold-security-bound}
\end{equation}
Authorization of decryption requests is enforced operationally by the
TDAs and is not implied solely by threshold encryption.
\hfill$\square$

\subsection{Theorem 6: Verifiable Aggregation Correctness}

\textbf{Theorem 6.}
Relative to the gateway-committed state, an accepted aggregate
contains exactly the ciphertexts associated with the verified
conjunctive result, with each selected bitmap position contributing
once.

\textbf{Proof.}
For each token $Tok_{j,i}$, the user requires exactly one returned
node that passes both the local ABSE matching test and index
Merkle-proof verification:
\begin{equation}
\begin{aligned}
&\mathsf{ABSE.Test}
(PP,I_u,Tok_{j,i},e_q,qid)=1 \\
&\quad \land\;
\mathsf{MerkleVerify}
(\sigma_u^{\mathrm{idx}},\pi_u^{\mathrm{idx}},
Root_{e_q}^{\mathrm{idx}})=1 .
\end{aligned}
\label{eq:sec-node-match-verification}
\end{equation}
By ABSE correctness, canonical-keyword uniqueness, and Merkle-proof
soundness, any omission, duplication, or substitution of a required
node causes verification to fail.

For every authenticated node, the user also requires
\begin{equation}
\{b:\widetilde B_{u,b}\text{ is returned}\}
=
\{1,\ldots,n_{e_q}^{\mathrm{blk}}\}
\label{eq:sec-block-completeness}
\end{equation}
and verifies each block against $Root_u^{\mathrm{bmp}}$. Therefore,
missing, duplicated, reordered, truncated, or modified blocks are
detected. After recovering and truncating every $B_u$ to the
authenticated length $N_{e_q}$, the user computes
\begin{equation}
\begin{aligned}
B_{D_j}
&=\bigvee_{u\in\mathcal M_j}B_u,
\qquad
B_Q=\bigwedge_{j=1}^{d}B_{D_j},\\
\mathcal S_Q
&=\{pos_i:B_Q[pos_i]=1\}.
\end{aligned}
\label{eq:sec-conjunctive-result}
\end{equation}

Each committed aggregation entry is
\begin{equation}
\begin{aligned}
\mathcal A_i
&=
(pos_i,rid_i,e_i,h_i^{\mathrm{rec}},
CT_v^{(i)},CT_1^{(i)}),\\
\sigma_i^{\mathrm{agg}}
&=
H\bigl(
\mathtt{AGG}\parallel e_i
\parallel\mathsf{enc}(\mathcal A_i)
\bigr).
\end{aligned}
\label{eq:sec-aggregation-entry}
\end{equation}
The user requires the returned position set to equal
$\mathcal S_Q$ and verifies
\begin{equation}
\mathsf{MerkleMultiVerify}
\left(
\{\sigma_i^{\mathrm{agg}}\}_{pos_i\in\mathcal S_Q},
\pi_Q^{\mathrm{agg}},
Root_{e_q}^{\mathrm{agg}}
\right)=1.
\label{eq:sec-aggregation-multiproof}
\end{equation}
It then independently recomputes
\begin{equation}
CT_{\mathrm{sum}}
=
\bigoplus_{E,\,pos_i\in\mathcal S_Q}CT_v^{(i)},
\qquad
CT_{\mathrm{count}}
=
\bigoplus_{E,\,pos_i\in\mathcal S_Q}CT_1^{(i)}.
\label{eq:sec-aggregation-correctness}
\end{equation}
Position-set equality prevents insertion or omission, while the
uniqueness of $pos_i$ prevents duplicate contributions. After
threshold decryption, the user additionally verifies
\begin{equation}
Count=|\mathcal S_Q|.
\label{eq:sec-count-correctness}
\end{equation}
Hence, every accepted aggregate contains exactly the authenticated
ciphertexts selected by the verified conjunctive bitmap, each counted
once. This completeness guarantee is relative to the state committed
by the honest-but-curious gateway and does not prove that every
real-world sensor event was initially indexed.
\hfill$\square$


\subsection{Theorem 7: Query-State Integrity, Freshness, and Rollback Resistance}

\textbf{Theorem 7.}
Assuming EUF-CMA security of the gateway signature, collision
resistance of $H$, Merkle-proof soundness, ABSE test soundness, and
blockchain finality, a malicious cloud cannot modify, omit,
substitute, replay, or roll back an accepted query response without
detection, except with negligible probability.

\textbf{Proof.}
For each finalized epoch $e_q$, the gateway computes and signs
\begin{equation}
\begin{aligned}
Root_{e_q}
=
H\bigl(
&\mathtt{EPOCH}\parallel e_q
\parallel N_{e_q}\parallel\beta
\parallel n_{e_q}^{\mathrm{blk}}\\
&\parallel Root_{e_q}^{\mathrm{idx}}
\parallel Root_{e_q}^{\mathrm{agg}}
\bigr),\\
\sigma_{\mathrm{DO}}
=
\mathsf{DS.Sign}_{sk_{\mathrm{DO}}}
\bigl(
&H(Root_{e_q}\parallel e_q\parallel ts_{e_q})
\bigr).
\end{aligned}
\label{eq:sec-epoch-state}
\end{equation}
Therefore, modifying the authenticated dataset size, bitmap
parameters, or either Merkle subroot requires finding a collision in
$H$ or forging $\sigma_{\mathrm{DO}}$.

For every submitted token, the user requires exactly one returned
node that passes the token-reference check, local ABSE test, and index
Merkle-proof verification. Thus, omission, duplication, or
substitution of a canonical node requires breaking ABSE test
soundness or Merkle-proof soundness.

For each matched node, the authenticated value
$n_{e_q}^{\mathrm{blk}}$ determines the expected block-index set:
\begin{equation}
\{b:\widetilde B_{u,b}\text{ is returned}\}
=
\{1,\ldots,n_{e_q}^{\mathrm{blk}}\}.
\label{eq:sec-block-set-integrity}
\end{equation}
Each block is verified against $Root_u^{\mathrm{bmp}}$ and ordered by
its authenticated index $b$ before reconstruction. Consequently,
omission, duplication, truncation, or modification of any bitmap
block is detected.

Similarly, the aggregation multi-proof binds every returned
$\mathcal A_i$ to $Root_{e_q}^{\mathrm{agg}}$. Any insertion,
omission, or modification changes its committed leaf or causes the
returned position set to differ from $\mathcal S_Q$. The response
digest
\begin{equation}
\begin{aligned}
\Delta_Q
=
H\bigl(
&\mathtt{RESP}\parallel e_q\parallel qid
\parallel Root_{e_q}\parallel H(B_Q)\\
&\parallel H(\mathsf{enc}(\{\mathcal A_i\}))
\parallel CT_{\mathrm{sum}}
\parallel CT_{\mathrm{count}}
\bigr)
\end{aligned}
\label{eq:sec-response-digest}
\end{equation}
binds the response components, while independent homomorphic
recomputation verifies the aggregate ciphertexts. Here, $\Delta_Q$
is a consistency digest rather than an independent authenticator;
response authenticity follows from the signed epoch root and the
corresponding Merkle proofs.

The query identifier
\begin{equation}
qid
=
H(e_q\parallel Root_{e_q}\parallel
t_{\mathrm{exp}}\parallel n_q)
\label{eq:sec-query-binding}
\end{equation}
binds the trapdoor and response to a unique nonce, finalized epoch,
and validity period. Cross-query or cross-epoch substitution fails
this binding, expired responses are rejected, and the user rejects a
$qid$ that has already completed. Freshness therefore means that
$e_q$ was finalized when $T_Q$ was created and remains pinned until
$t_{\mathrm{exp}}$; it need not remain the globally latest epoch
throughout the multi-round query.

Consequently,
\begin{equation}
\begin{aligned}
\Pr[\mathsf{Forge}]
\leq{}&
\mathsf{Adv}_{\mathsf{DS}}^{\mathrm{EUF\mbox{-}CMA}}
+\mathsf{Adv}_{H}^{\mathrm{CR}}
+\mathsf{Adv}^{\mathrm{Merkle}}\\
&+
\mathsf{Adv}^{\mathrm{ABSE\mbox{-}Test}}
+\mathsf{Adv}_{\mathrm{BC}}^{\mathrm{Finality}}
+\operatorname{negl}(\lambda).
\end{aligned}
\label{eq:query-state-security-bound}
\end{equation}
Hence, BVCRSA provides query-state integrity, response freshness, and
rollback resistance relative to the state committed by the
honest-but-curious gateway.
\hfill$\square$


\subsection{Security Scope and Limitations}

BVCRSA authenticates query results relative to the state constructed
by the honest-but-curious gateway; it does not prove that all
real-world sensor events were initially indexed. It also leaks
canonical-node matches, query repetition, selected positions, and
result cardinality. Eliminating this leakage would require additional
mechanisms such as ORAM, PIR, zero-knowledge proofs, or trusted
hardware.

Finally, the node key
\begin{equation}
K_u
=
F(K_{\mathrm{sel}},D_j\parallel u)
\label{eq:static-node-key-limitation}
\end{equation}
is stable across epochs. A previously authorized user retaining
$K_u$ may decrypt future protected blocks for the same node if it can
obtain them. Thus, the present construction provides policy-controlled
access but not cryptographic forward revocation. Forward revocation
would require epoch-evolving node keys and re-encapsulation or
revocation-aware key updates.


