\subsubsection*{\textbf{Phase 1 --- System Setup}}

The TA initializes the cryptographic parameters
and distributes the required credentials. Let $\lambda$ be the
security parameter, $\mathcal{U}$ the attribute universe, and
$\mathcal{D}=\{D_1,\ldots,D_d\}$ the searchable numerical dimensions.

\paragraph*{Step 1: ABSE Initialization}

The TA initializes the Attribute-Based Searchable Encryption (ABSE)
scheme as
\begin{equation}
(PP,MSK)
\leftarrow
\mathsf{ABSE.Setup}(1^\lambda),
\qquad
PP=(p,\mathbb{G}_1,\mathbb{G}_T,e,g),
\label{eq:abse-setup}
\end{equation}
where $(p,\mathbb{G}_1,\mathbb{G}_T,e,g)$ are the BN254 pairing
parameters. For each authorized user with attribute set
$\mathcal{A}\subseteq\mathcal{U}$, the TA generates
\begin{equation}
SK_{\mathcal{A}}
\leftarrow
\mathsf{ABSE.KeyGen}(MSK,\mathcal{A}).
\label{eq:abse-keygen}
\end{equation}
It also samples a selector key and derives its epoch-specific form as
\begin{equation}
K_s\xleftarrow{\$}\{0,1\}^{\lambda},
\qquad
K_s^{(e_q)}=H(K_s\parallel e_q),
\label{eq:epoch-selector}
\end{equation}
where $e_q$ is the current authenticated blockchain epoch.

\paragraph*{Step 2: Threshold Homomorphic Encryption Initialization}

The TA initializes lifted threshold EC-ElGamal over NIST P-256. Let
$G$ be the curve generator and $q_E$ its order. It generates
\begin{equation}
x\xleftarrow{\$}\mathbb{Z}_{q_E}^{*},
\qquad
pk_{\mathrm{AHE}}=xG,
\label{eq:ahe-keygen}
\end{equation}
and constructs a degree-$(t-1)$ Shamir polynomial
\begin{equation}
f(z)=x+\sum_{j=1}^{t-1}a_jz^j,
\qquad
a_j\xleftarrow{\$}\mathbb{Z}_{q_E}^{*}.
\label{eq:shamir-poly}
\end{equation}
The secret and public shares of TDA $\ell$ are
\begin{equation}
sk_\ell=f(\ell),
\qquad
pk_\ell=sk_\ell G,
\qquad
\ell\in\{1,\ldots,n\}.
\label{eq:tda-shares}
\end{equation}
A bounded numerical value $v$ is encrypted as
\begin{equation}
CT_v
=
\bigl(rG,\,vG+rpk_{\mathrm{AHE}}\bigr),
\qquad
r\xleftarrow{\$}\mathbb{Z}_{q_E}^{*},
\label{eq:ahe-encryption}
\end{equation}
thereby supporting additive homomorphic aggregation.

\paragraph*{Step 3: Primitive Initialization}

The TA instantiates HMAC-SHA-256 as the pseudorandom function $F$,
a BN254-compatible hash-to-group function $H_g$, SHA-256 as $H$,
HKDF-SHA-256 as $\mathsf{KDF}$, and ECDSA over secp256k1 as
\begin{equation}
\mathsf{DS}
=
(\mathsf{KeyGen},\mathsf{Sign},\mathsf{Verify}).
\label{eq:signature-scheme}
\end{equation}

\paragraph*{Step 4: Credential Distribution}

For each sensor $i$, the TA derives
\begin{equation}
\begin{aligned}
K_{\mathrm{AES}}^{(i)}
&=\mathsf{KDF}
  (K_{\mathrm{master}},ID_i\parallel\mathtt{enc}),\\
K_{\mathrm{HMAC}}^{(i)}
&=\mathsf{KDF}
  (K_{\mathrm{master}},ID_i\parallel\mathtt{hmac}).
\end{aligned}
\label{eq:sensor-keys}
\end{equation}
It then samples the selection key and generates the Edge Gateway
signing keys:
\begin{equation}
K_{\mathrm{sel}}\xleftarrow{\$}\{0,1\}^{\lambda},
\qquad
(pk_{\mathrm{DO}},sk_{\mathrm{DO}})
\leftarrow
\mathsf{DS.KeyGen}(1^\lambda).
\label{eq:gateway-keys}
\end{equation}
Through authenticated secure channels, the TA distributes
\begin{equation}
\begin{aligned}
\text{Sensor }i &:\
(K_{\mathrm{AES}}^{(i)},K_{\mathrm{HMAC}}^{(i)},pk_{\mathrm{AHE}}),\\
\text{Authorized user} &:\
(SK_{\mathcal{A}},K_s,K_{\mathrm{sel}}),\\
\text{Edge Gateway} &:\
(K_{\mathrm{sel}},sk_{\mathrm{DO}}),\\
\text{TDA }\ell &:\
(sk_\ell,pk_\ell).
\end{aligned}
\label{eq:credential-distribution}
\end{equation}

\paragraph*{Step 5: Blockchain Initialization}

Finally, the TA anchors the initial authenticated-state commitment
$Root_0$ on the permissioned blockchain and publishes
\begin{equation}
\mathsf{Pub}
=
\left(
PP,pk_{\mathrm{AHE}},pk_{\mathrm{DO}},
\{pk_\ell\}_{\ell=1}^{n}
\right),
\label{eq:public-parameters}
\end{equation}
while keeping
\begin{equation}
\mathsf{Sec}
=
\left(
MSK,K_s,K_{\mathrm{sel}},K_{\mathrm{master}},
sk_{\mathrm{DO}},\{sk_\ell\}_{\ell=1}^{n}
\right)
\label{eq:secret-parameters}
\end{equation}
confidential.
\subsubsection*{\textbf{Phase 2 --- Sensor-Side Encryption and Authenticated Index Construction}}

This phase transforms sensor readings into authenticated structures
supporting conjunctive range search, encrypted aggregation, and
blockchain-verifiable integrity.

\paragraph*{Step 1: Sensor Encryption and Authentication}

For a sensor record
\begin{equation}
D_i=(m_i,\mathbf{x}_i,t_i,v_i),
\qquad
\mathbf{x}_i=(x_{i,1},\ldots,x_{i,d}),
\label{eq:p2-record}
\end{equation}
the sensor derives
\begin{equation}
rid_i=H(ID_i\parallel seq_i),
\qquad
Meta_i=\{(D_j,u_{i,j})\}_{j=1}^{d},
\label{eq:p2-metadata}
\end{equation}
where $u_{i,j}$ is the canonical leaf containing $x_{i,j}$. It then
computes
\begin{equation}
\begin{aligned}
CT_{\mathrm{AES}}^{(i)}
&=
\mathsf{AES\mbox{-}GCM.Enc}_{K_{\mathrm{AES}}^{(i)}}
(N_i,D_i;ID_i\parallel rid_i\parallel seq_i),\\
CT_v^{(i)}
&=
(r_iG,v_iG+r_i pk_{\mathrm{AHE}}),
\quad
r_i\xleftarrow{\$}\mathbb{Z}_{q_E}^{*}.
\end{aligned}
\label{eq:p2-encryption}
\end{equation}
The transmitted packet and its authenticator are
\begin{equation}
\begin{aligned}
\mathcal{P}_i
&=
(ID_i,rid_i,seq_i,N_i,
CT_{\mathrm{AES}}^{(i)},CT_v^{(i)},Meta_i,Tag_i),\\
Tag_i
&=
\mathsf{HMAC}_{K_{\mathrm{HMAC}}^{(i)}}
(\mathsf{enc}(\mathcal{P}_i\setminus\{Tag_i\})).
\end{aligned}
\label{eq:p2-packet}
\end{equation}

\paragraph*{Step 2: Edge Verification and Bitmap Update}

The gateway accepts $\mathcal{P}_i$ only if
\begin{equation}
\mathsf{HMAC.Verify}_{K_{\mathrm{HMAC}}^{(i)}}
(\mathcal{P}_i,Tag_i)=1
\land seq_i>seq_i^{\mathrm{last}}
\land\mathsf{Valid}(Meta_i)=1.
\label{eq:p2-verification}
\end{equation}
It atomically registers $rid_i$, assigns a unique bitmap position
$pos_i$, updates $seq_i^{\mathrm{last}}\leftarrow seq_i$, and sets
\begin{equation}
B_u[pos_i]\leftarrow1,
\qquad
u\in\mathsf{Path}(u_{i,j}),
\quad
(D_j,u_{i,j})\in Meta_i.
\label{eq:p2-bitmap-update}
\end{equation}

\paragraph*{Step 3: Policy-Bound Index Construction}

For each node $u$ representing $[l_u,r_u]$, the gateway derives
\begin{equation}
\tau_u=H_g(D_j\parallel l_u\parallel r_u),
\qquad
K_u=F(K_{\mathrm{sel}},D_j\parallel u),
\label{eq:p2-node-key}
\end{equation}
and constructs
\begin{equation}
I_u
=
\mathsf{ABSE.Index}(PP,\tau_u,\mathcal{P}_u,e_q),
\qquad
C_u^K
=
\mathsf{ABSE.Enc}(PP,K_u,\mathcal{P}_u,e_q).
\label{eq:p2-abse-index}
\end{equation}
Thus, only users satisfying $\mathcal{P}_u$ can match $I_u$ and
recover $K_u$.

Each bitmap is divided into fixed-size blocks. Only a modified block
is re-masked:
\begin{equation}
\begin{aligned}
\nu_{u,b}&\leftarrow\nu_{u,b}+1,\\
\widetilde{B}_{u,b}
&=
B_{u,b}\oplus
\mathsf{PRG}\!\left(
F(K_u,b\parallel\nu_{u,b}),|B_{u,b}|
\right),\\
\sigma_{u,b}^{\mathrm{bmp}}
&=
H(\mathtt{BMP}\parallel D_j\parallel u\parallel b
\parallel\nu_{u,b}\parallel\widetilde{B}_{u,b}).
\end{aligned}
\label{eq:p2-protected-block}
\end{equation}
The corresponding authenticated index leaf is
\begin{equation}
\begin{aligned}
Root_u^{\mathrm{bmp}}
&=
\mathsf{MerkleRoot}
(\mathsf{Sort}_{b}\{\sigma_{u,b}^{\mathrm{bmp}}\}),\\
\sigma_u^{\mathrm{idx}}
&=
H(\mathtt{IDX}\parallel e_q\parallel D_j\parallel u
\parallel I_u\parallel C_u^K\parallel Root_u^{\mathrm{bmp}}).
\end{aligned}
\label{eq:p2-index-leaf}
\end{equation}

\paragraph*{Step 4: Aggregation Registration}

For each accepted record, the gateway creates
\begin{equation}
\begin{aligned}
CT_1^{(i)}
&=
\mathsf{Enc}^{\mathrm{AHE}}_{pk_{\mathrm{AHE}}}(1),\\
h_i^{\mathrm{rec}}
&=
H(rid_i\parallel CT_{\mathrm{AES}}^{(i)}),\\
\mathcal{A}_i
&=
(pos_i,rid_i,h_i^{\mathrm{rec}},
CT_v^{(i)},CT_1^{(i)}),\\
\sigma_i^{\mathrm{agg}}
&=
H(\mathtt{AGG}\parallel e_q
\parallel\mathsf{enc}(\mathcal{A}_i)).
\end{aligned}
\label{eq:p2-aggregation-entry}
\end{equation}
The unique pair $(pos_i,rid_i)$ prevents duplicate contributions and
links each bitmap position to one aggregation entry.

\paragraph*{Step 5: Epoch Commitment and Outsourcing}

At the end of epoch $e_q$, the gateway computes
\begin{equation}
\begin{aligned}
Root_{e_q}^{\mathrm{idx}}
&=
\mathsf{MerkleRoot}
(\mathsf{Sort}_{(D_j,u)}\{\sigma_u^{\mathrm{idx}}\}),\\
Root_{e_q}^{\mathrm{agg}}
&=
\mathsf{MerkleRoot}
(\mathsf{Sort}_{pos_i}\{\sigma_i^{\mathrm{agg}}\}),\\
Root_{e_q}
&=
H(\mathtt{EPOCH}\parallel e_q
\parallel Root_{e_q}^{\mathrm{idx}}
\parallel Root_{e_q}^{\mathrm{agg}}),\\
\sigma_{\mathrm{DO}}
&=
\mathsf{DS.Sign}_{sk_{\mathrm{DO}}}
(H(Root_{e_q}\parallel e_q\parallel ts_{e_q})).
\end{aligned}
\label{eq:p2-epoch-commitment}
\end{equation}
It anchors
\begin{equation}
(e_q,Root_{e_q},ts_{e_q},\sigma_{\mathrm{DO}})
\label{eq:p2-anchor}
\end{equation}
on the blockchain and outsources
\begin{equation}
\mathcal{O}_{e_q}
=
\left\{
CT_{\mathrm{AES}}^{(i)},I_u,C_u^K,
\widetilde{B}_{u,b},\nu_{u,b},
\mathcal{A}_i,
\sigma_{u,b}^{\mathrm{bmp}},
\sigma_u^{\mathrm{idx}},
\sigma_i^{\mathrm{agg}}
\right\}
\label{eq:p2-outsourcing}
\end{equation}
to the cloud. The gateway retains $K_{\mathrm{sel}}$, while users
recover only the node keys authorized by their ABSE policies.
\subsubsection*{\textbf{Phase 3 --- Conjunctive Range-Query Trapdoor Generation}}

An authorized user with attribute key $SK_{\mathcal A}$ generates an
epoch-bound trapdoor for a conjunctive range query. The construction
hides the queried nodes under the keyword-privacy property of ABSE,
while revealing only the padded query structure and access pattern.

\paragraph*{Step 1: Canonical Range Decomposition}

A $d$-dimensional conjunctive query is
\begin{equation}
Q
=
\bigwedge_{j=1}^{d}
\bigl(D_j,[a_j,b_j]\bigr).
\label{eq:p3-query}
\end{equation}
For each dimension $D_j$, the user computes the minimal canonical
cover
\begin{equation}
\mathcal{C}_j
=
\mathsf{Cover}(D_j,[a_j,b_j])
=
\{u_{j,1},\ldots,u_{j,\ell_j}\},
\qquad
\ell_j=O(\log |D_j|).
\label{eq:p3-canonical-cover}
\end{equation}
Nodes within $\mathcal{C}_j$ are evaluated disjunctively, whereas
the results across dimensions are evaluated conjunctively.

\paragraph*{Step 2: Epoch-Bound Token Generation}

The user retrieves the latest finalized epoch $e_q$ and its
authenticated root $Root_{e_q}$ from the blockchain. It then samples
a fresh query nonce and derives
\begin{equation}
n_q\xleftarrow{\$}\{0,1\}^{\lambda},
\qquad
qid
=
H(e_q\parallel Root_{e_q}\parallel n_q).
\label{eq:p3-query-id}
\end{equation}
For each $u_{j,i}\in\mathcal{C}_j$ representing interval
$[l_{u_{j,i}},r_{u_{j,i}}]$, the user reconstructs the public node
keyword
\begin{equation}
\tau_{j,i}
=
H_g\bigl(
D_j\parallel l_{u_{j,i}}\parallel r_{u_{j,i}}
\bigr)
\label{eq:p3-node-keyword}
\end{equation}
and invokes the native randomized ABSE token algorithm:
\begin{equation}
Tok_{j,i}
\leftarrow
\mathsf{ABSE.Token}
\bigl(
PP,SK_{\mathcal A},\tau_{j,i},e_q,qid
\bigr).
\label{eq:p3-search-token}
\end{equation}
Binding each token to $(e_q,qid)$ prevents its substitution across
epochs or queries. The cloud rejects expired epochs and previously
accepted query identifiers.

\paragraph*{Step 3: Query-Shape Protection}

To prevent the canonical-cover size from directly revealing the
queried range width, each token group is padded to
\begin{equation}
L_j
=
2\left\lceil\log_2|D_j|\right\rceil,
\qquad
\widehat{\Gamma}_j
=
\mathsf{Shuffle}
\left(
\{Tok_{j,i}\}_{i=1}^{\ell_j}
\cup
\{\bot\}^{L_j-\ell_j}
\right),
\label{eq:p3-token-padding}
\end{equation}
where $\bot$ denotes an indistinguishable dummy token generated by
the ABSE token algorithm. Padding may be omitted when range-size
leakage is included in the declared leakage profile.

\paragraph*{Step 4: Trapdoor Construction}

The final trapdoor is
\begin{equation}
T_Q
=
\left(
e_q,Root_{e_q},qid,t_{\mathrm{exp}},
\{\widehat{\Gamma}_j\}_{j=1}^{d}
\right),
\label{eq:p3-final-trapdoor}
\end{equation}
where $t_{\mathrm{exp}}$ limits its validity. Its padded size is
\begin{equation}
|T_Q|
=
O\left(
\sum_{j=1}^{d}\log|D_j|
\right).
\label{eq:p3-trapdoor-size}
\end{equation}

For each token, the cloud subsequently evaluates
$\mathsf{ABSE.Test}(I_u,Tok_{j,i})$ against the index $I_u$ from
Phase~2. It returns only the matching $(C_u^K,\widetilde{B}_{u,b})$
and their Merkle proofs. After verifying the proofs, the authorized
user recovers
\begin{equation}
K_u
=
\mathsf{ABSE.Dec}
(SK_{\mathcal A},C_u^K,e_q)
\label{eq:p3-node-key-recovery}
\end{equation}
and reconstructs each authorized block as
\begin{equation}
B_{u,b}
=
\widetilde{B}_{u,b}
\oplus
\mathsf{PRG}\left(
F(K_u,b\parallel\nu_{u,b}),|B_{u,b}|
\right).
\label{eq:p3-bitmap-recovery}
\end{equation}
Thus, neither the global selector key $K_{\mathrm{sel}}$ nor raw
bitmap selectors are exposed in the trapdoor.

\subsubsection*{\textbf{Phase 4 --- Verifiable Conjunctive Range Search and Aggregation}}

Using $T_Q$, the cloud identifies authorized index nodes and returns
their authenticated protected bitmaps. The user reconstructs the
conjunctive result, after which the cloud aggregates the corresponding
ciphertexts and provides a Merkle multi-proof of correctness. The
protocol reveals the accessed nodes and result positions to the cloud
but not the plaintext query values or sensor data.

\paragraph*{Step 1: Authorized Node Matching}

For every token $Tok_{j,i}\in\widehat{\Gamma}_j$, the cloud evaluates
\begin{equation}
b_{u,j,i}
=
\mathsf{ABSE.Test}
(PP,I_u,Tok_{j,i},e_q,qid).
\label{eq:p4-token-test}
\end{equation}
If $b_{u,j,i}=1$, the cloud adds $u$ to the matched-node set
$\mathcal{M}_j$. Dummy tokens produce no match. It then returns
\begin{equation}
\mathcal{Rsp}_Q^{(1)}
=
\left(
e_q,qid,
\left\{
I_u,C_u^K,
\{\widetilde{B}_{u,b},\nu_{u,b}\}_{b},
\pi_u^{\mathrm{idx}},
\{\pi_{u,b}^{\mathrm{bmp}}\}_{b}
\right\}_{u\in\mathcal{U}_Q}
\right),
\label{eq:p4-first-response}
\end{equation}
where
\begin{equation}
\mathcal{U}_Q
=
\bigcup_{j=1}^{d}\mathcal{M}_j.
\label{eq:p4-matched-node-set}
\end{equation}
Here, $\pi_u^{\mathrm{idx}}$ authenticates $\sigma_u^{\mathrm{idx}}$
against $Root_{e_q}^{\mathrm{idx}}$, while
$\pi_{u,b}^{\mathrm{bmp}}$ authenticates each bitmap block against
$Root_u^{\mathrm{bmp}}$ committed by $\sigma_u^{\mathrm{idx}}$.

\paragraph*{Step 2: User-Side Bitmap Verification and Evaluation}

The user first verifies the blockchain signature and epoch root:
\begin{equation}
\mathsf{DS.Verify}_{pk_{\mathrm{DO}}}
\left(
H(Root_{e_q}\parallel e_q\parallel ts_{e_q}),
\sigma_{\mathrm{DO}}
\right)=1.
\label{eq:p4-epoch-verification}
\end{equation}
The user also verifies all index and bitmap Merkle proofs. For every
authenticated node, it recovers
\begin{equation}
K_u
=
\mathsf{ABSE.Dec}
(SK_{\mathcal A},C_u^K,e_q)
\label{eq:p4-node-key-recovery}
\end{equation}
and reconstructs each bitmap block as
\begin{equation}
B_{u,b}
=
\widetilde{B}_{u,b}
\oplus
\mathsf{PRG}\left(
F(K_u,b\parallel\nu_{u,b}),|B_{u,b}|
\right).
\label{eq:p4-bitmap-recovery}
\end{equation}
After concatenating the verified blocks into $B_u$, the user computes
\begin{equation}
B_{D_j}
=
\bigvee_{u\in\mathcal{M}_j}B_u,
\qquad
B_Q
=
\bigwedge_{j=1}^{d}B_{D_j}.
\label{eq:p4-conjunctive-bitmap}
\end{equation}
The selected bitmap positions are
\begin{equation}
\mathcal{S}_Q
=
\{pos_i\mid B_Q[pos_i]=1\}.
\label{eq:p4-selected-positions}
\end{equation}
The user sends the query-bound selection request
\begin{equation}
\mathcal{Req}_Q^{\mathrm{agg}}
=
(e_q,qid,H(B_Q),\mathcal{S}_Q)
\label{eq:p4-aggregation-request}
\end{equation}
to the cloud through the authenticated session established for
$T_Q$. The cloud accepts it only if $(e_q,qid)$ is valid, unexpired,
and associated with the same query session.

\paragraph*{Step 3: Encrypted Aggregation}

For each $pos_i\in\mathcal{S}_Q$, the cloud retrieves the unique
aggregation entry $\mathcal{A}_i$ and computes
\begin{equation}
CT_{\mathrm{sum}}
=
\bigoplus_{E,\,pos_i\in\mathcal{S}_Q}CT_v^{(i)},
\qquad
CT_{\mathrm{count}}
=
\bigoplus_{E,\,pos_i\in\mathcal{S}_Q}CT_1^{(i)},
\label{eq:p4-encrypted-aggregation}
\end{equation}
where $\oplus_E$ denotes EC-ElGamal ciphertext addition. Because
$\mathcal{S}_Q$ is a set of unique bitmap positions, each record
contributes at most once.

The cloud generates an aggregation Merkle multi-proof
\begin{equation}
\pi_Q^{\mathrm{agg}}
=
\mathsf{MerkleMultiProof}
\left(
\{\sigma_i^{\mathrm{agg}}\}_{pos_i\in\mathcal{S}_Q},
Root_{e_q}^{\mathrm{agg}}
\right).
\label{eq:p4-aggregation-proof}
\end{equation}

\paragraph*{Step 4: Verifiable Response Construction}

The cloud computes a response digest
\begin{equation}
\begin{aligned}
\Delta_Q
=
H\bigl(
&\mathtt{RESP}\parallel e_q\parallel qid
\parallel Root_{e_q}\parallel H(B_Q)\\
&\parallel H(\mathsf{enc}(\{\mathcal{A}_i\}))
\parallel CT_{\mathrm{sum}}
\parallel CT_{\mathrm{count}}
\bigr),
\end{aligned}
\label{eq:p4-response-digest}
\end{equation}
where the aggregation entries are canonically ordered by $pos_i$.
The final response is
\begin{equation}
\mathcal{Rsp}_Q^{(2)}
=
\left(
e_q,qid,H(B_Q),
CT_{\mathrm{sum}},CT_{\mathrm{count}},
\{\mathcal{A}_i\}_{pos_i\in\mathcal{S}_Q},
\pi_Q^{\mathrm{agg}},\Delta_Q
\right).
\label{eq:p4-final-response}
\end{equation}

The user verifies $\pi_Q^{\mathrm{agg}}$ against
$Root_{e_q}^{\mathrm{agg}}$, confirms that the returned positions are
exactly $\mathcal{S}_Q$, and independently recomputes
\begin{equation}
\widehat{CT}_{\mathrm{sum}}
=
\bigoplus_{E,\,pos_i\in\mathcal{S}_Q}CT_v^{(i)},
\qquad
\widehat{CT}_{\mathrm{count}}
=
\bigoplus_{E,\,pos_i\in\mathcal{S}_Q}CT_1^{(i)}.
\label{eq:p4-aggregation-recomputation}
\end{equation}
The response is accepted only if
\begin{equation}
\widehat{CT}_{\mathrm{sum}}=CT_{\mathrm{sum}}
\;\land\;
\widehat{CT}_{\mathrm{count}}=CT_{\mathrm{count}}
\;\land\;
\Delta_Q=\widehat{\Delta}_Q.
\label{eq:p4-response-acceptance}
\end{equation}
Thus, the authenticated bitmaps establish result completeness, while
the aggregation multi-proof and ciphertext recomputation establish
that every selected record is included exactly once and no additional
record is aggregated.

If record retrieval is requested, the cloud also returns
\begin{equation}
\left\{
CT_{\mathrm{AES}}^{(i)}
\right\}_{pos_i\in\mathcal{S}_Q},
\label{eq:p4-record-retrieval}
\end{equation}
which the user verifies using $h_i^{\mathrm{rec}}$ before decryption.
After successful verification, at least $t$ TDAs jointly decrypt
$CT_{\mathrm{sum}}$ and $CT_{\mathrm{count}}$.

\subsubsection*{\textbf{Phase 5 --- Blockchain-Anchored Verification and Threshold Decryption}}

Upon receiving

\[
\begin{aligned}
Rsp_Q
=
\Bigl(
&
e,
CT_{sum},
CT_{count},
B_Q,
\mathcal R_Q,
\Pi_{batch},
\\
&
\{\sigma_u\}_{u\in\mathcal U_Q},
\{\sigma_u^{bmp}\}_{u\in\mathcal U_Q},
\\
&
\{\pi_u\}_{u\in\mathcal U_Q},
\{\pi_u^{bmp}\}_{u\in\mathcal U_Q},
Root_e,
\{CT_{K_i}\}
\Bigr),
\end{aligned}
\]

the user first verifies the authenticity, integrity,
completeness, and freshness of the returned query result
before performing threshold aggregate decryption or
optional record decryption.

\paragraph*{Step 1: Blockchain and Query-State Verification}

The user retrieves the authenticated state

\[
State_e
=
(
e,
Root_e^{idx},
Root_e^{agg},
Root_e^{bmp},
Root_e,
ts,
\sigma_{DO}
)
\]

from the blockchain, verifies

\begin{equation}
\mathsf{DS.Verify}_{pk_{DO}}
\bigl(
H(Root_e\parallel ts),
\sigma_{DO}
\bigr)
=
1,
\end{equation}

and confirms that \(e\) is the latest finalized epoch.
The user reconstructs the canonical range cover from the
query trapdoor, verifies that the returned canonical-node
set matches the expected decomposition, validates all
Merkle proofs against
\(Root_e^{idx}\)
and
\(Root_e^{bmp}\),
and recomputes

\begin{equation}
\begin{aligned}
\Pi_{batch}^{*}
=
H\Bigl(
&
Root_e
\parallel
H(\{\sigma_u\})
\\
&
\parallel
H(\{\sigma_u^{bmp}\})
\parallel
H(B_Q)
\\
&
\parallel
H(\mathcal R_Q)
\parallel
CT_{sum}
\parallel
CT_{count}
\Bigr).
\end{aligned}
\end{equation}

The response is accepted for decryption only if

\[
\Pi_{batch}^{*}
=
\Pi_{batch}.
\]
Successful verification confirms the authenticity,
integrity, completeness, and freshness of the authenticated
query state, and cryptographically binds the returned
aggregation ciphertexts
\((CT_{sum},CT_{count})\)
to the verified bitmap
\(B_Q\)
and matched record set
\(\mathcal R_Q\).
\paragraph*{Step 2: Threshold Aggregate Decryption}

After successful verification, the user submits
\((CT_{sum},CT_{count})\) to a set
\(S\) of Threshold Decryption Authorities satisfying
\(|S|\ge t\). Each authority
\(\ell\in S\) computes

\[
\delta_\ell^{sum}
=
sk_\ell C_1^{sum},
\qquad
\delta_\ell^{count}
=
sk_\ell C_1^{count},
\]

which are verified using the corresponding public
verification keys. The user reconstructs

\[
D_{sum}
=
\sum_{\ell\in S}
\lambda_\ell
\delta_\ell^{sum},
\qquad
D_{count}
=
\sum_{\ell\in S}
\lambda_\ell
\delta_\ell^{count},
\]

and recovers

\[
M_{sum}
=
C_2^{sum}
-
D_{sum},
\qquad
M_{count}
=
C_2^{count}
-
D_{count}.
\]

Finally,

\[
Sum
=
\mathsf{BSGS}(M_{sum}),
\qquad
Count
=
\mathsf{BSGS}(M_{count}),
\]

and

\[
Avg
=
\frac{Sum}{Count},
\qquad
Count>0.
\]

\paragraph*{Step 3: Optional Record Decryption}

During data outsourcing, the Edge Gateway generates an
ABSE-protected key envelope

\[
CT_{K_i}
=
\textsf{ABSE.Enc}
(PP,
K_{AES}^{(i)},
\mathcal P).
\]

For record-retrieval queries, each returned
\(CT_{AES}^{(i)}\) is accompanied by
\(CT_{K_i}\). A user whose attributes satisfy
\(\mathcal P\) recovers
\(K_{AES}^{(i)}\) and decrypts

\[
D_i
=
\textsf{AES\mbox{-}GCM.Dec}
(K_{AES}^{(i)},
CT_{AES}^{(i)}).
\]

The AES-GCM authentication tag provides end-to-end record
integrity and authenticity. The query result is accepted
only if blockchain verification, canonical-cover
verification, Merkle-proof validation, authenticated batch
verification, and the requested decryption operation(s)
complete successfully; otherwise, the response is rejected.

\section{Security Analysis}

\subsection{Security Model}

We consider a probabilistic polynomial-time (PPT)
adversary \(\mathcal A\) that controls the cloud server
and communication channels. During normal protocol
execution, the Edge Gateway is assumed to be
honest-but-curious and faithfully performs sensor
authentication, authenticated index construction,
aggregation-metadata generation, and blockchain
commitment, while attempting to infer information only
from the permitted leakage.

The adversary observes encrypted records, searchable
ciphertexts, protected bitmaps, aggregation metadata,
query trapdoors, Merkle proofs, authenticated batch
commitments, blockchain states, and the leakage function
\(\mathcal L_{BVCRSA}\). It may adaptively issue
ciphertext, trapdoor, aggregation, and verification
queries, and may attempt to infer plaintext information
beyond the permitted leakage, generate unauthorized
trapdoors, omit, modify, replay, or fabricate query
responses, or forge verification proofs.

The adversary does not possess the ABSE master secret
\(MSK\), the long-term bitmap-selector secret
\(K_s\), the Edge Gateway signing key
\(sk_{DO}\), any unauthorized attribute secret key, or
the threshold decryption shares
\(\{sk_\ell\}_{\ell=1}^{n}\). The query-specific selector
key

\[
K_s'
=
H(K_s\parallel e_q)
\]

is deterministically derived only by authorized users
during trapdoor generation and is never disclosed to the
Edge Gateway or the cloud. We assume that fewer than
\(t\) Threshold Decryption Authorities (TDAs) may be
corrupted; consequently, the threshold decryption key
cannot be reconstructed and aggregation ciphertexts
remain confidential. Detecting or tolerating a malicious
Edge Gateway that intentionally anchors incorrect
authenticated states before blockchain commitment is
outside the scope of this work.

The security objective of BVCRSA is to guarantee

\begin{equation}
\begin{aligned}
&
\mathsf{Privacy}
\wedge
\mathsf{Confidentiality}
\wedge
\mathsf{AntiCollusion}
\\
&
{}\wedge
\mathsf{QueryStateIntegrity}
\wedge
\mathsf{QueryStateCompleteness}
\wedge
\mathsf{Freshness},
\end{aligned}
\end{equation}

while revealing only the leakage explicitly specified by
\(\mathcal L_{BVCRSA}\). In particular, BVCRSA
cryptographically authenticates that the returned
aggregation ciphertexts correspond to the verified
matched record set and authenticated query state, but it
does not claim general verifiable computation for
arbitrary homomorphic operations.
\subsection{Leakage Function}

BVCRSA follows the standard adaptive searchable-encryption
leakage model and reveals only the structural information
required for encrypted query processing. The leakage profile
is defined as

\begin{equation}
\mathcal L_{BVCRSA}
=
\Bigl(
\mathcal L_{\mathsf{Setup}},
\mathcal L_{\mathsf{Data}},
\mathcal L_{\mathsf{Query}},
\mathcal L_{\mathsf{Access}}
\Bigr).
\end{equation}

During setup, only the public parameters are revealed,

\begin{equation}
\mathcal L_{\mathsf{Setup}}=PP,
\end{equation}

while all master secret keys, attribute keys, aggregation
private keys, bitmap-selector secrets, and signing keys
remain hidden.

For outsourced data, the cloud learns

\begin{equation}
\mathcal L_{\mathsf{Data}}
=
\bigl(
|CT_{AES}|,\,
|CT_v|,\,
|\mathcal P_v|
\bigr),
\end{equation}

where \(|CT_{AES}|\) and \(|CT_v|\) denote the ciphertext
sizes and \(|\mathcal P_v|\) is the number of canonical
range-cover nodes associated with a record.

For each query,

\begin{equation}
\mathcal L_{\mathsf{Query}}
=
\bigl(
|T_Q|,\,
Pat_Q
\bigr),
\end{equation}

where \(Pat_Q\) is the search pattern indicating whether two
queries produce the same matched canonical-node set.

During query execution, the cloud observes

\begin{equation}
\mathcal L_{\mathsf{Access}}
=
\bigl(
\mathcal U_Q,\,
\{B_u\},\,
B_Q,\,
\mathcal R_Q,\,
|\mathcal R_Q|
\bigr),
\end{equation}

where \(\mathcal U_Q\) denotes the matched canonical nodes,
\(\{B_u\}\) the recovered node bitmaps,
\(B_Q\) the conjunctive bitmap,
\(\mathcal R_Q\) the matched record set, and
\(|\mathcal R_Q|\) the result cardinality.
Accordingly,

\begin{equation}
\begin{aligned}
\mathcal L_{BVCRSA}
=
\Bigl(
&
PP,\,
|CT_{AES}|,\,
|CT_v|,\,
|\mathcal P_v|,
\\
&
|T_Q|,\,
Pat_Q,\,
\mathcal U_Q,\,
\{B_u\},
\\
&
B_Q,\,
\mathcal R_Q,\,
|\mathcal R_Q|
\Bigr).
\end{aligned}
\end{equation}

Beyond this leakage, BVCRSA reveals no information about
plaintext sensor records, numerical values, queried ranges,
search dimensions, homomorphic decryption results,
bitmap-selector secrets, aggregation private keys, or
authenticated query-state signing keys. Similar to existing
searchable-encryption schemes
(e.g., Refs.~\cite{ref26,ref27,ref28,ref16}),
BVCRSA leaks search and access patterns that may allow an
honest-but-curious cloud to infer coarse statistics such as
query selectivity or data distribution. In addition, BVCRSA
reveals authenticated canonical-node and bitmap information
to support query-state verification and encrypted
aggregation without requiring ORAM, zero-knowledge proofs,
or trusted hardware.

\subsection{Theorem 1: Conjunctive Query Privacy}

\textbf{Theorem 1.}
Assuming the adaptive security of ABSE and the
pseudorandomness of
\(F(K_s',\cdot)\), BVCRSA preserves conjunctive query
privacy against probabilistic polynomial-time adversaries,
revealing no information beyond the leakage function
\(\mathcal L_{BVCRSA}\).

\textbf{Proof.}

We prove the theorem through a sequence of games.

\textbf{Game \(G_0\).}
The adversary observes the real execution of BVCRSA,
including searchable ciphertexts, query tokens, node
selectors, authenticated batch commitments, Merkle proofs,
and blockchain states.

\textbf{Game \(G_1\).}
Replace each node selector

\begin{equation}
Sel_{j,i}
=
F
\bigl(
K_s',
D_j
\parallel
u_{j,i}
\bigr)
\end{equation}

with a uniformly random value of the same length.
Distinguishing \(G_1\) from \(G_0\) breaks the
pseudorandomness of
\(F(K_s',\cdot)\). Therefore,

\begin{equation}
\left|
Pr[G_1]-Pr[G_0]
\right|
\le
Adv_{\mathcal A}^{PRF}(\lambda).
\end{equation}

\textbf{Game \(G_2\).}
Replace the ABSE searchable ciphertexts and query tokens
with simulated values generated solely from the leakage
function
\(\mathcal L_{BVCRSA}\).
By the adaptive security of ABSE,

\begin{equation}
\left|
Pr[G_2]-Pr[G_1]
\right|
\le
Adv_{\mathcal A}^{ABSE}(\lambda).
\end{equation}

Hence, the adversary's view in \(G_2\) is completely
determined by
\(\mathcal L_{BVCRSA}\), revealing no additional
information regarding plaintext sensor records, queried
numerical ranges, searchable dimensions, homomorphic
decryption results, or secret cryptographic material.

Therefore,

\begin{equation}
\begin{aligned}
Adv_{\mathcal A}^{CQ}
\le {}&
Adv_{\mathcal A}^{PRF}(\lambda)
+
Adv_{\mathcal A}^{ABSE}(\lambda)
\\
&
+
negl(\lambda).
\end{aligned}
\end{equation}

Hence, BVCRSA preserves conjunctive query privacy under
the leakage function
\(\mathcal L_{BVCRSA}\).
\hfill\(\square\)

\subsection{Theorem 2: Confidentiality of Outsourced IIoT Sensor Data}

\textbf{Theorem 2.}
Assuming the IND-CPA security of AES-GCM and Threshold
EC-ElGamal, BVCRSA preserves the confidentiality of
outsourced IIoT sensor data against probabilistic
polynomial-time adversaries, revealing no information
beyond the leakage function
\(\mathcal L_{BVCRSA}\).

\textbf{Proof.}

Each sensor record

\[
D_i=(m_i,k_i,t_i,v_i)
\]

is encrypted using AES-GCM as

\begin{equation}
CT_{AES}^{(i)}
=
\textsf{AES\mbox{-}GCM.Enc}
\bigl(
K_{AES}^{(i)},
D_i
\bigr),
\end{equation}

which is computationally indistinguishable from random
under the IND-CPA security of AES-GCM.

The numerical value \(v_i\) is independently encrypted
using Threshold EC-ElGamal as

\begin{equation}
CT_v^{(i)}
=
(r_iG,\,
v_iG+r_iP),
\end{equation}

where

\[
r_i
\xleftarrow{\$}
\mathbb Z_p^{*}.
\]

The corresponding decryption key is distributed among
\(n\) Threshold Decryption Authorities using Shamir secret
sharing. Under the assumption that fewer than \(t\)
authorities are corrupted, neither the cloud nor any
coalition of unauthorized users and fewer than \(t\) TDAs
can reconstruct the decryption key or recover the
underlying plaintext values.

Consequently, an adversary learns only the information
explicitly specified by
\(\mathcal L_{BVCRSA}\), while the confidentiality of both
encrypted sensor records and aggregation ciphertexts is
preserved. Therefore,

\begin{equation}
\begin{aligned}
Adv_{\mathcal A}^{Conf}
\le {}&
Adv_{\mathcal A}^{AES}(\lambda)
\\
&
+
Adv_{\mathcal A}^{T\text{-}ECElGamal}(\lambda)
+
negl(\lambda),
\end{aligned}
\end{equation}

where
\(Adv_{\mathcal A}^{AES}(\lambda)\)
and
\(Adv_{\mathcal A}^{T\text{-}ECElGamal}(\lambda)\)
denote the IND-CPA advantages against AES-GCM and
Threshold EC-ElGamal, respectively. Hence, BVCRSA
preserves the confidentiality of outsourced IIoT sensor
data.
\hfill\(\square\)

\subsection{Theorem 3: Threshold Aggregate-Decryption Security}

\textbf{Theorem 3.}
Assuming the IND-CPA security of Threshold EC-ElGamal,
no probabilistic polynomial-time adversary controlling the
cloud server, unauthorized users, and fewer than \(t\)
Threshold Decryption Authorities can recover the plaintext
of an aggregate ciphertext or reconstruct the aggregation
private key.

\textbf{Proof.}

Let

\[
CT=(C_1,C_2)
\]

denote an aggregate ciphertext encrypted under the public
key \(pk_{AHE}\). The corresponding private key is shared
among \(n\) Threshold Decryption Authorities using a
\((t,n)\)-threshold secret-sharing scheme, where each
authority stores only its secret share \(sk_\ell\).

For decryption, each participating authority computes the
partial decryption

\begin{equation}
\delta_\ell
=
sk_\ell C_1.
\end{equation}

After collecting at least \(t\) valid partial decryptions,
the user reconstructs

\begin{equation}
D
=
\sum_{\ell\in S}
\lambda_\ell
\delta_\ell,
\qquad
|S|\ge t,
\end{equation}

where \(\lambda_\ell\) denotes the corresponding Lagrange
coefficient. The plaintext group element is then recovered
as

\begin{equation}
M
=
C_2-D.
\end{equation}

Since fewer than \(t\) secret shares reveal no information
about the underlying decryption key, neither the cloud nor
any coalition of unauthorized users and fewer than \(t\)
Threshold Decryption Authorities can reconstruct the
private key or decrypt aggregate ciphertexts. Moreover,
partial decryptions are generated only after successful
verification of the authenticated query response in
Phase~5, preventing unauthorized decryption requests.

Therefore,

\begin{equation}
Adv_{\mathcal A}^{TDec}
\le
Adv_{\mathcal A}^{T\text{-}ECElGamal}(\lambda)
+
negl(\lambda).
\end{equation}

Hence, BVCRSA preserves threshold-secure aggregate
decryption.
\hfill\(\square\)

\subsection{Theorem 4: Anti-Collusion Security}

\textbf{Theorem 4.}
Colluding users cannot generate valid search trapdoors for unauthorized
conjunctive range queries unless their combined attributes satisfy the
embedded access policy.

\textbf{Proof.}

For every searchable node, the corresponding search token is generated as

\begin{equation}
\begin{aligned}
Tok_{j,i} = {} & \textsf{ABSE.TokenGen} \left( SK_{\mathcal A}, \tau_{u_{j,i}} \right),
\end{aligned}
\end{equation}

where \(SK_{\mathcal A}\) is the attribute secret key associated with
attribute set \(\mathcal A\).

A valid token can be generated only when the user's attribute set
satisfies the access policy

\begin{equation}
\mathcal A
\models
\mathcal P.
\end{equation}

Suppose multiple users collude by combining attribute secret keys

\begin{equation}
SK_{\mathcal A_1},
SK_{\mathcal A_2},
\ldots,
SK_{\mathcal A_t}.
\end{equation}

Under the anti-collusion property of ABSE, secret-key components are
cryptographically bound to their originating users and cannot be
combined to construct a valid key for an unauthorized attribute set.

Consequently, the colluding users cannot generate a valid token

\begin{equation}
Tok_{j,i}^{*}
\end{equation}

for any policy that is not individually satisfied.

Therefore,

\begin{equation}
Adv_{\mathcal A}^{Coll}
\le
Adv_{\mathcal A}^{ABSE}
+
negl(\lambda).
\end{equation}

Hence, BVCRSA achieves anti-collusion security.
\subsection{Theorem 5: Aggregation Correctness}

\textbf{Theorem 5.}
The aggregate ciphertexts are computed exclusively over the
records satisfying all queried range predicates, with each
matched record contributing exactly once.

\textbf{Proof.}

For each queried dimension \(D_j\), the cloud identifies the
matched canonical-node set

\begin{equation}
\begin{aligned}
\mathcal M_j
=
\Bigl\{
u
\;\Big|\;
&
\textsf{ABSE.Match}
(
Tok_{j,i},
\\
&
CT_u^{tag}
)
=
1
\Bigr\}.
\end{aligned}
\end{equation}

The corresponding dimension-level bitmap is obtained by

\begin{equation}
B_{D_j}
=
\bigvee_{u\in\mathcal M_j}
B_u,
\end{equation}

and the conjunctive bitmap is computed as

\begin{equation}
B_Q
=
\bigwedge_{j=1}^{d}
B_{D_j}.
\end{equation}

Hence,

\begin{equation}
\begin{aligned}
B_Q[i]=1
\iff
&
(D_1\in[a_1,b_1])
\\
&
\wedge\cdots\wedge
(D_d\in[a_d,b_d]),
\end{aligned}
\end{equation}

and the matched record set is uniquely determined as

\begin{equation}
\mathcal R_Q
=
\{\,r_i\mid B_Q[i]=1\,\}.
\end{equation}

The cloud performs homomorphic aggregation only over the
authenticated aggregation metadata associated with
\(\mathcal R_Q\):

\begin{equation}
CT_{sum}
=
\bigoplus_{r_i\in\mathcal R_Q}
CT_v^{(i)},
\end{equation}

\begin{equation}
CT_{count}
=
\bigoplus_{r_i\in\mathcal R_Q}
Enc^{AHE}_{pk_{AHE}}(1).
\end{equation}

Since each record identifier appears at most once in
\(\mathcal R_Q\), every matched record contributes exactly
once to both aggregate ciphertexts, while no record outside
\(\mathcal R_Q\) participates in the aggregation.
Furthermore, the authenticated batch commitment binds
\((B_Q,\mathcal R_Q,CT_{sum},CT_{count})\), enabling the
user to verify in Phase~5 that the returned aggregate
ciphertexts correspond to the verified query result.

Therefore, the aggregate ciphertexts correctly represent
the sum and count of all records satisfying the conjunctive
range query.
\hfill\(\square\)
\subsection{Theorem 6: Query-State Integrity, Freshness, and Rollback Resistance}

\textbf{Theorem 6.}
A probabilistic polynomial-time adversary cannot forge,
modify, substitute, omit, replay, or roll back an
authenticated query state or its associated aggregation
ciphertexts without detection, except with negligible
probability.

\textbf{Proof.}

For each epoch \(e\), the Edge Gateway computes

\begin{equation}
Root_e
=
H\!\left(
Root_e^{idx}
\parallel
Root_e^{agg}
\parallel
Root_e^{bmp}
\parallel
e
\right),
\end{equation}

followed by

\begin{equation}
m_e
=
H(Root_e\parallel ts),
\end{equation}

and generates

\begin{equation}
\sigma_{DO}
=
\mathsf{DS.Sign}_{sk_{DO}}(m_e),
\end{equation}

before anchoring
\((e,Root_e,ts,\sigma_{DO})\)
on the blockchain.

For each query response, the cloud computes

\begin{equation}
\begin{aligned}
\Pi_{batch}
=
H\Bigl(
&
Acc_e
\parallel
Root_e^{agg}
\\
&
\parallel
H(\{\sigma_u\})
\parallel
H(\{\sigma_u^{bmp}\})
\\
&
\parallel
H(B_Q)
\parallel
CT_{sum}
\parallel
CT_{count}
\Bigr).
\end{aligned}
\end{equation}

During verification, the user reconstructs the expected
canonical range cover from the submitted query, verifies
that the returned canonical-node set matches the expected
decomposition, validates all Merkle proofs, verifies the
blockchain-anchored epoch commitment, and recomputes
\(\Pi_{batch}\). Consequently, any modification,
substitution, omission, replay, or rollback of the
authenticated searchable nodes, bitmap commitments,
conjunctive bitmap, aggregation ciphertexts, or
blockchain-authenticated query state changes either
\(Root_e\), \(m_e\), or \(\Pi_{batch}\), causing
verification failure. Freshness is ensured by requiring
the latest finalized blockchain epoch, thereby preventing
the acceptance of stale or previously authenticated query
states.

Therefore,

\begin{equation}
\begin{aligned}
Pr[\mathsf{Forge}]
\le {}&
Adv_{\mathcal A}^{\mathsf{ECDSA\mbox{-}EUF\mbox{-}CMA}}
(\lambda)
\\
&
+
Adv_{H}^{CR}(\lambda)
+
negl(\lambda),
\end{aligned}
\end{equation}

where a successful attack requires either forging a valid
Edge Gateway signature or finding a collision in the hash
function \(H(\cdot)\). Hence, BVCRSA guarantees
authenticated query-state integrity, completeness,
freshness, and rollback resistance by
cryptographically binding the returned canonical nodes,
bitmap commitments, conjunctive bitmap, aggregation
ciphertexts, and blockchain-authenticated query state.


\hfill\(\square\)

\subsection{Theorem 7: Cryptographic Query-Token Unlinkability}

\textbf{Theorem 7.}
Assuming the pseudorandomness of
\(F(K_s',\cdot)\) and the adaptive security of ABSE,
BVCRSA provides cryptographic unlinkability of
query-specific node selectors and randomized ABSE query
tokens across different query epochs, subject to the
leakage function
\(\mathcal L_{BVCRSA}\).

\textbf{Proof.}

For each query epoch \(e_q\), the authorized user derives
the query-specific selector key

\[
K_s'
=
H(K_s\parallel e_q),
\]

and computes the node selector

\begin{equation}
Sel_{j,i}
=
F
\Bigl(
K_s',
D_j
\parallel
u_{j,i}
\Bigr).
\end{equation}

Since \(K_s'\) is uniquely derived for each query epoch,
selectors generated for the same canonical node across
different epochs are computationally independent under the
pseudorandomness of
\(F(K_s',\cdot)\).

Furthermore, each ABSE query token is freshly randomized
during trapdoor generation. Under the adaptive security of
ABSE, these randomized tokens reveal no information beyond
the leakage function
\(\mathcal L_{BVCRSA}\).

Therefore, distinguishing whether two node selectors or
ABSE query tokens originate from the same query beyond the
permitted leakage would require either distinguishing
\(F(K_s',\cdot)\) from a random function or breaking the
adaptive security of ABSE. Hence,

\begin{equation}
Adv_{\mathcal A}^{Link}
\le
Adv_{\mathcal A}^{PRF}(\lambda)
+
Adv_{\mathcal A}^{ABSE}(\lambda)
+
negl(\lambda).
\end{equation}

Accordingly, BVCRSA provides cryptographic unlinkability
of query-specific node selectors and randomized ABSE query
tokens across different query epochs. However, repeated or
overlapping queries may still be correlated through the
search and access patterns explicitly permitted by
\(\mathcal L_{BVCRSA}\), including matched canonical-node
sets, recovered bitmaps, matched record sets, and query
result cardinalities.
\hfill\(\square\)

\subsection{Theorem 8: Query-State Freshness and Rollback Resistance}

\textbf{Theorem 8.}
A malicious cloud cannot successfully replay stale query states or rollback authenticated search results.

\textbf{Proof.}

For every epoch $e$, the blockchain stores the authenticated query state

\begin{equation}
\begin{aligned}
State_e = ( & e, Root_e^{idx}, Root_e^{agg}, Root_e^{bmp}, \\
& Acc_e, ts, \sigma_{DO} ).
\end{aligned}
\end{equation}

Before accepting a query result, the user verifies that the returned state corresponds to the latest finalized blockchain epoch.

Suppose the cloud returns a stale state $State_{e'}$ where

\begin{equation}
e'
<
e.
\end{equation}

The freshness verification immediately detects the existence of a newer finalized epoch and rejects the response.

Furthermore, any modification of

\begin{equation}
Root_e^{idx},
\quad
Root_e^{agg},
\quad
Root_e^{bmp}
\end{equation}

changes

\begin{equation}
\begin{aligned}
Acc_e = H \left( & Root_e^{idx} \parallel Root_e^{agg} \parallel Root_e^{bmp} \right),
\end{aligned}
\end{equation}

which invalidates the authenticated blockchain state.

Therefore, rollback succeeds only if blockchain finality or the collision resistance of $H(\cdot)$ is broken.

Hence,

\begin{equation}
Pr[\textsf{Rollback}]
\le
Adv_{BC}
+
Adv_H
+
negl(\lambda).
\end{equation}

Thus, BVCRSA achieves query-state freshness and rollback resistance.


